{
  "permissions": {
    "deny": [
      "Bash(*--setrw*)",
      "Bash(*hdparm*-r0*)",
      "Bash(*hdparm*-r 0*)",
      "Bash(*/etc/claude-code*)",
      "Bash(*lf-claude-guard*)",
      "Edit(//etc/claude-code/**)",
      "Edit(//usr/local/bin/lf-claude-guard)",
      "Edit(//run/lf/readonly)",
      "Bash(*lf-freigabe*)",
      "Bash(*sudoers*)",
      "Edit(//etc/sudoers.d/**)"
    ],
    "disableBypassPermissionsMode": "disable"
  },
  "disableAutoMode": "disable",
  "allowManagedPermissionRulesOnly": true,
  "allowManagedHooksOnly": true,
  "strictPluginOnlyCustomization": true,
  "claudeMdExcludes": [
    "/mnt/**",
    "/media/**",
    "/run/media/**"
  ],
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "/usr/local/bin/lf-claude-guard",
            "timeout": 10,
            "onFailure": "block"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "/usr/local/bin/lf-freigabe zeile"
  }
}
