#!/bin/bash
# Leuchtfeuer: Volles sudo für Claude (lf-claude), nur auf ausdrücklichen Wunsch des
# Technikers, nur für diese Sitzung und nur für eine begrenzte Zeit.
#
#   sudo lf-freigabe an [MINUTEN]   freischalten oder verlängern (Vorgabe 30, höchstens 240)
#   sudo lf-freigabe aus            sofort beenden
#   lf-freigabe status              "aus", "aus, Neustart empfohlen (…)", "an bis HH:MM", "an, ohne
#                                   Ablauf" oder "an: Rückstand …"
#   lf-freigabe zeile               Statuszeile für Claude Code (managed-settings.json)
#
# Auslösen kann nur ein Benutzer mit sudo, also der Techniker, nie lf-claude: Dessen sudo-Regel
# erlaubt nur lf-lesen und lf-aufgabe, und "an" lehnt jeden Aufruf ab, der von lf-claude kommt.
# Solange Claude root hat (Freigabe oder Rückstand), könnte Claude selbst verlängern. Dann gilt
# "an" nur von einer Konsole des Geräts (tty1 bis tty63, nicht über SSH, tmux oder systemd-run)
# und nur, wenn dort jemand die Rückfrage mit "j" beantwortet. Der Assistent zeigt die Freigabe
# in jedem Menü an. Ein systemd-Timer nimmt sie nach Ablauf zurück, ein Neustart ebenso (/etc
# liegt im RAM). Jedes An und Aus steht im Protokoll und im Journal.
#
# Ob ein Aufruf von lf-claude kommt, zeigen SUDO_USER und SUDO_UID, alle Vorfahren des Aufrufs
# und die cgroup: Claude läuft in einer eigenen (lf-claude.slice, claude_scope in claude.sh), und
# ein Prozess behält sie, auch wenn er sich abkoppelt. Am Ende (aus, Ablauf) hält lf-freigabe
# diese cgroup an und nimmt sofort die Regel zurück. Eine neue /etc/ld.so.preload sperrt es, und
# hat sich an lf-aufgabe, lf-lesen oder den Programmen darunter etwas geändert, bis zum Neustart
# auch die Grundregel. Dann beendet es Einheiten, Timer, at-Aufträge und cron-Dateien, die
# während der Freigabe entstanden sind (außer Diensten, die Claude über lf-aufgabe auch ohne
# Freigabe bekommt: kept_unit), jeden root-Prozess in der cgroup (außer sudo selbst und Jobs von
# lf-lesen und lf-aufgabe) und alles, was lf-claude sonst nachweislich mit der Freigabe gestartet
# hat, setzt die Umgebung des systemd-Managers zurück und lässt Claude weiterlaufen. Danach prüft
# es, ob lf-claude noch mehr darf als lf-lesen und lf-aufgabe, auch über Wege ohne laufenden
# Prozess (Dateien wie /etc/shadow oder PAM, setuid-Dateien, /usr, Kernel-Einstellungen,
# Einhängungen); solange es etwas findet, sagt status "an: Rückstand …". Ob die Freigabe gilt,
# entscheidet die Regel selbst, nicht die Uhr; das Ende kommt aus dem monotonen Timer. Keine
# Prüfung findet jeden Weg, den sich root einrichten kann: Sicher endet eine Freigabe nur mit
# einem Neustart (GHSA-799j-44qx-x7xj). Bis dahin sagt status nach jeder Freigabe "aus, Neustart
# empfohlen".
set -u
PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
export LC_ALL=C.UTF-8
RULE=/etc/sudoers.d/lf-claude-freigabe
SUDOERS_D=/etc/sudoers.d/
SUDOERS=/etc/sudoers
UNTIL=/run/lf/claude-freigabe-bis
UNIT=lf-claude-freigabe-ende
CLAUDE=lf-claude
SUDO_EXE=/usr/bin/sudo
# Die cgroup von Claude, CLI und Desktop (claude_scope in claude.sh).
SLICE=lf-claude.slice
CGROOT=/sys/fs/cgroup
# Was es beim Freischalten schon gab: Einheiten, at-Aufträge, cron- und sudo-Dateien.
SNAP=/run/lf/claude-freigabe-vorher
LINGER=/var/lib/systemd/linger
CRON_PATHS=(/etc/crontab /etc/cron.d /var/spool/cron/crontabs)
# Die Rückfrage beim Verlängern geht an das Terminal, nie über Standardein- und -ausgabe.
TTY=/dev/tty
# Was lf-claude nach dem Ende einer Freigabe noch mehr darf als die Grundregel.
RESIDUE=/run/lf/claude-freigabe-rueckstand
BASE_RULE="(root) NOPASSWD: /usr/local/bin/lf-lesen, /usr/local/bin/lf-aufgabe"
# Blockgeräte, die der Kernel kennt (Quellen, die kept_unit gelten lässt).
SYS_BLOCK=/sys/class/block
# Die Programme, die ntfs3g_ro in recover.sh und start_rescue in lf-aufgabe als Dienst starten,
# und lf-aufgabe selbst, das am Ende die Argumente einer Rettung prüft.
NTFS3G=/usr/bin/ntfs-3g
RESCUE_RUN=/usr/local/bin/lf-rescue-run
BASH_EXE=/usr/bin/bash
AUFGABE=/usr/local/bin/lf-aufgabe
# Wo lf-aufgabe Quellen einhängt (LF_IMAGE_MNT in common.sh).
IMAGE_MNT=/mnt/lf-image
# Variablen, die fremden Code in ein Programm laden (Lader, glibc, bash). Kein Dienst, den
# lf-freigabe startet, erbt sie aus der Umgebung des Managers (UnsetEnvironment=), und kept_unit
# lässt keinen Prozess gelten, der eine davon hat. Dieselbe Liste steht als LF_ENV_UNSAFE in
# common.sh, für die Dienste von recover.sh und lf-aufgabe.
ENV_UNSAFE="LD_PRELOAD LD_LIBRARY_PATH LD_AUDIT GLIBC_TUNABLES GCONV_PATH LOCPATH BASH_ENV ENV SHELLOPTS BASHOPTS PS4"
# Wurzel der Pfade darunter (die Tests setzen einen eigenen Ordner).
WROOT=
# Dateien und Ordner, über die sich root einen Weg zurück einrichten kann, ohne dass ein Prozess
# läuft: Konten und Kennwörter, der Lader, PAM, polkit, sudo, SSH, systemd und seine Generatoren,
# dazu modprobe (install-Zeilen laufen als root, ein fehlendes Modul fordert auch lf-claude an),
# udev-Regeln, was die Shells des Technikers lesen (er hat sudo), D-Bus, NSS und Unit-Dateien
# und Drop-ins von systemd (ein ExecStopPost an einer Einheit, die schon vor der Freigabe lief,
# liefe erst beim Stoppen, als root). Neu, geändert oder entfernt ist ein Rückstand. Die
# lf-Werkzeuge prüft check_chain, /usr im Ganzen fs_new. Nicht dabei: /run/systemd/transient,
# dort legt systemd-run jeden Dienst an, auch den Timer dieser Freigabe.
WATCH=(
	"$WROOT"/etc/passwd "$WROOT"/etc/shadow "$WROOT"/etc/group "$WROOT"/etc/gshadow
	"$WROOT"/etc/ld.so.preload "$WROOT"/etc/ld.so.preload.lf-gesperrt "$WROOT"/etc/ld.so.conf
	"$WROOT"/etc/ld.so.conf.d "$WROOT"/etc/ld.so.cache "$WROOT"/etc/pam.d "$WROOT"/etc/security
	"$WROOT"/etc/polkit-1/rules.d "$WROOT"/usr/share/polkit-1/rules.d "$WROOT"/etc/sudo.conf
	"$WROOT"/etc/ssh "$WROOT"/root/.ssh "$WROOT"/etc/systemd/system.conf "$WROOT"/etc/systemd/system.conf.d
	"$WROOT"/{etc/systemd,run/systemd,usr/local/lib/systemd,usr/lib/systemd}/{system-generators,system-environment-generators,user-environment-generators}
	"$WROOT"/etc/modprobe.d "$WROOT"/run/modprobe.d "$WROOT"/etc/udev/rules.d "$WROOT"/run/udev/rules.d
	"$WROOT"/etc/profile "$WROOT"/etc/profile.d "$WROOT"/etc/bash.bashrc "$WROOT"/etc/environment
	"$WROOT"/etc/nsswitch.conf "$WROOT"/etc/dbus-1
	"$WROOT"/{etc,run}/systemd/{system,system.control,user}
)
# Lädt der Lader in jedes Programm, auch in sudo. Neu oder geändert: gesperrt wie cron-Dateien.
PRELOAD=$WROOT/etc/ld.so.preload
# Was die Grundregel als root ausführt: die lf-Werkzeuge, alles, was sie aus /usr/local laden oder
# starten, und die Programme, über die sie laufen. Ändert sich daran etwas oder kommt etwas dazu
# (etwa eine bash unter /usr/local/bin, die env vor /usr/bin findet), sperrt das Ende die
# Grundregel bis zum Neustart.
CHAIN_DIRS=("$WROOT"/usr/local/bin "$WROOT"/usr/local/sbin "$WROOT"/usr/local/lib/lf)
CHAIN_BINS=("$WROOT"/usr/bin/bash "$WROOT"/usr/bin/env "$WROOT"/usr/bin/sudo "$WROOT"/usr/bin/systemd-run "$WROOT"/usr/bin/ntfs-3g)
# Kernel-Einstellungen, über die der Kernel selbst ein Programm als root startet: bei einem Absturz
# (core_pattern mit |), für ein fehlendes Modul (modprobe), bei einem Geräteereignis (uevent_helper)
# und als Interpreter für ein Dateiformat (binfmt_misc, mit dem Flag C auch für sudo).
KNOBS=(/proc/sys/kernel/core_pattern /proc/sys/kernel/modprobe "$WROOT"/sys/kernel/uevent_helper)
BINFMT=/proc/sys/fs/binfmt_misc
# Höchstdauer je Suche am Ende einer Freigabe: Ein FUSE-Dateisystem, das root über einen geprüften
# Ordner gelegt hat, hält sonst das Ende auf. Abgebrochen zählt wie geändert.
SCAN_TIMEOUT=30
# Die Grundregel von lf-claude (build/chroot-setup.sh).
BASE_FILE=/etc/sudoers.d/lf-claude
# Wann die letzte Freigabe endete: bis zum Neustart (/run liegt im RAM) empfiehlt status einen. an
# legt die Marke schon mit dem geplanten Ende an (auch ein abgebrochenes Ende hinterlässt dann kein
# blankes "aus"), off schreibt das tatsächliche.
LAST=/run/lf/claude-freigabe-zuletzt

note() {
	logger -t lf-freigabe -- "$*" 2>/dev/null || true
	printf '%s %s\n' "$(date '+%F %T')" "$*" >>/run/lf/claude-aufgaben.log 2>/dev/null || true
	echo "$*"
}

# trace TEXT   Nur ins Protokoll: welcher Schritt am Ende einer Freigabe gerade dran ist.
trace() {
	printf '%s %s\n' "$(date '+%F %T')" "$*" >>/run/lf/claude-aufgaben.log 2>/dev/null || true
}

# scan BEFEHL …   BEFEHL mit Höchstdauer SCAN_TIMEOUT, danach KILL (auch ein FUSE-Zugriff endet so).
#   Das trifft nur BEFEHL selbst (timeout von uutils beendet keine Enkel): Was liest, läuft direkt
#   unter scan, nicht über xargs. Ein Enkel liefe sonst weiter und hielte die Pipe offen.
scan() {
	timeout -s KILL "$SCAN_TIMEOUT" "$@"
}

# st PID   "RUID EUID PPID ZUSTAND" aus /proc/PID/status, leer wenn es PID nicht gibt.
st() {
	awk '$1 == "Uid:" {r = $2; e = $3} $1 == "PPid:" {p = $2} $1 == "State:" {s = $2}
		END {if (r != "") print r, e, p, s}' "/proc/$1/status" 2>/dev/null
}

# ttynr PID   Das steuernde Terminal von PID als Gerätenummer (Feld 7 in /proc/PID/stat), 0 ohne.
ttynr() {
	local s
	local -a f
	{ read -r s <"/proc/$1/stat"; } 2>/dev/null || return 1
	s=${s##*) }
	read -ra f <<<"$s"
	echo "${f[4]:-0}"
}

# gone PID   Gibt es PID nicht mehr? Ein fremder Prozess (kill ohne Recht) gilt als vorhanden.
gone() {
	local err
	err=$(kill -0 "$1" 2>&1) && return 1
	[[ $err == *"No such process"* ]]
}

# prog PID   Das Programm von PID. /proc/PID/exe ist für andere Benutzer ohne root nicht lesbar,
#   dann gilt das erste Wort der Befehlszeile.
prog() {
	local x
	x=$(readlink "/proc/$1/exe" 2>/dev/null)
	[[ -n $x ]] || x=$(tr '\0' '\n' <"/proc/$1/cmdline" 2>/dev/null | head -n 1)
	echo "$x"
}

# is_sudo PID   Läuft in PID sudo selbst? Als root zählt nur das Programm, nicht der Name.
is_sudo() {
	if [[ -n $(readlink "/proc/$1/exe" 2>/dev/null) ]]; then
		[[ /proc/$1/exe -ef $SUDO_EXE ]]
	else
		[[ $(cat "/proc/$1/comm" 2>/dev/null) == sudo ]]
	fi
}

# claude_cgroups   Die cgroups von Claude: lf-claude.slice (CLI und Desktop) und, falls es sie
#   gibt, die Benutzer-Slice von lf-claude (Anmeldungen und Benutzerdienste).
claude_cgroups() {
	local cg cu
	cg=$(systemctl show -p ControlGroup --value "$SLICE" 2>/dev/null)
	[[ $cg == /?* && -d $CGROOT$cg ]] && echo "$CGROOT$cg"
	cu=$(id -u "$CLAUDE" 2>/dev/null) || return 0
	[[ -d $CGROOT/user.slice/user-$cu.slice ]] && echo "$CGROOT/user.slice/user-$cu.slice"
	return 0
}

# in_claude_cgroup   Läuft dieser Aufruf selbst in einer cgroup von Claude?
in_claude_cgroup() {
	local own cg
	own=$(sed -n 's/^0:://p' /proc/self/cgroup 2>/dev/null)
	[[ -n $own ]] || return 1
	while IFS= read -r cg; do
		cg=${cg#"$CGROOT"}
		[[ $own == "$cg" || $own == "$cg"/* ]] && return 0
	done < <(claude_cgroups)
	return 1
}

# caller_from_claude   Kommt dieser Aufruf von lf-claude? SUDO_USER, SUDO_UID, ein Vorfahr, der
#   als lf-claude läuft, oder die cgroup von Claude.
caller_from_claude() {
	local cu pid=$PPID n=0 r e p s
	[[ ${SUDO_USER:-} == "$CLAUDE" ]] && return 0
	cu=$(id -u "$CLAUDE" 2>/dev/null) || return 1
	[[ ${SUDO_UID:-} == "$cu" ]] && return 0
	while [[ $pid =~ ^[0-9]+$ ]] && ((pid > 1 && n++ < 64)); do
		read -r r e p s <<<"$(st "$pid")"
		[[ $r == "$cu" || $e == "$cu" ]] && return 0
		pid=$p
	done
	in_claude_cgroup
}

# caller_on_console   Sitzt der Aufrufer an einer Konsole des Geräts? Der erste Vorfahr ohne
#   root-Rechte (effektive UID nicht 0: der Techniker vor sudo) hat ein virtuelles Terminal als
#   steuerndes Terminal (tty1 bis tty63, Hauptnummer 4). Es zählt die effektive UID: sudo-rs
#   behält in sudo und seinem Überwacher die reale UID des Technikers, und der Überwacher sitzt an
#   einem eigenen Pseudo-Terminal. Ein Pseudo-Terminal (SSH, tmux) zählt nicht, ein Aufruf über
#   systemd-run hat keinen solchen Vorfahren.
caller_on_console() {
	local pid=$PPID n=0 r e p s t min
	while [[ $pid =~ ^[0-9]+$ ]] && ((pid > 1 && n++ < 64)); do
		read -r r e p s <<<"$(st "$pid")"
		if [[ $e =~ ^[0-9]+$ ]] && ((e != 0)); then
			t=$(ttynr "$pid") || return 1
			[[ $t =~ ^[0-9]+$ ]] || return 1
			min=$(((t & 0xff) | ((t >> 12) & 0xfff00)))
			((((t >> 8) & 0xfff) == 4 && min >= 1 && min <= 63))
			return
		fi
		pid=$p
	done
	return 1
}

# caller_name   Wer freischaltet: der erste Vorfahr ohne root-Rechte (effektive UID, wie bei
#   caller_on_console: der Techniker vor sudo), sonst SUDO_USER, sonst root.
caller_name() {
	local pid=$PPID n=0 r e p s
	while [[ $pid =~ ^[0-9]+$ ]] && ((pid > 1 && n++ < 64)); do
		read -r r e p s <<<"$(st "$pid")"
		if [[ $e =~ ^[0-9]+$ ]] && ((e != 0)); then
			id -nu "$e" 2>/dev/null || echo "uid $e"
			return 0
		fi
		pid=$p
	done
	echo "${SUDO_USER:-root}"
}

# from_claude PID UID   Hat lf-claude (UID) diesen Prozess über die Freigabe gestartet? Erkannt an
#   SUDO_USER=lf-claude in seiner Umgebung oder an den Vorfahren: über sudo von einem Prozess von
#   lf-claude. Was über die Grundregel läuft (lf-lesen, lf-aufgabe und ihre Jobs), zählt nicht,
#   ebenso wenig ein setuid-Programm, das lf-claude ohne sudo startet (etwa chrome-sandbox).
from_claude() {
	local pid=$1 n=0 r e p s c via_sudo=0
	grep -qzE '^SUDO_COMMAND=/usr/local/bin/lf-(lesen|aufgabe)( |$)' "/proc/$pid/environ" 2>/dev/null && return 1
	grep -qzx "SUDO_USER=$CLAUDE" "/proc/$pid/environ" 2>/dev/null && return 0
	while [[ $pid =~ ^[0-9]+$ ]] && ((pid > 1 && n++ < 64)); do
		grep -qaE '/usr/local/bin/lf-(lesen|aufgabe)' "/proc/$pid/cmdline" 2>/dev/null && return 1
		read -r r e p s <<<"$(st "$pid")"
		c=$(cat "/proc/$pid/comm" 2>/dev/null)
		if [[ $c == sudo ]]; then
			via_sudo=1
		elif [[ $r == "$2" || $e == "$2" ]]; then
			((via_sudo)) && return 0
			return 1
		fi
		pid=$p
	done
	return 1
}

# granted_pids   Laufende Prozesse, die lf-claude über die Freigabe gestartet hat, als root oder
#   als ein anderer Benutzer (sudo -u).
granted_pids() {
	local d pid cu r e p s
	cu=$(id -u "$CLAUDE" 2>/dev/null) || return 0
	for d in /proc/[0-9]*; do
		pid=${d##*/}
		((pid == $$ || pid == PPID)) && continue
		read -r r e p s <<<"$(st "$pid")"
		[[ $e != "$cu" && $s != Z ]] || continue
		kill -0 "$pid" 2>/dev/null || continue
		from_claude "$pid" "$cu" && echo "$pid"
	done
	return 0
}

# stop_granted   Beendet die Prozesse aus granted_pids: TERM, nach 5 Sekunden KILL. In den
#   cgroups von Claude, die off angehalten hat, käme TERM erst nach dem Auftauen an: dort gleich KILL.
stop_granted() {
	local pid i
	local -a pids
	local -A held=()
	mapfile -t pids < <(granted_pids)
	((${#pids[@]})) || return 0
	while IFS= read -r pid; do held[$pid]=1; done < <(cg_pids)
	for pid in "${pids[@]}"; do
		if [[ -n ${held[$pid]:-} ]]; then
			note "beendet: $pid $(tr '\0' ' ' <"/proc/$pid/cmdline" 2>/dev/null | cut -c1-120) (KILL, angehalten)"
			kill -KILL "$pid" 2>/dev/null
		else
			note "beendet: $pid $(tr '\0' ' ' <"/proc/$pid/cmdline" 2>/dev/null | cut -c1-120)"
			kill -TERM "$pid" 2>/dev/null
		fi
	done
	for ((i = 0; i < 10; i++)); do
		mapfile -t pids < <(granted_pids)
		((${#pids[@]})) || return 0
		sleep 0.5
	done
	for pid in "${pids[@]}"; do kill -KILL "$pid" 2>/dev/null; done
	return 0
}

# cg_pids   Alle Prozesse in den cgroups von Claude, auch in ihren Unter-cgroups.
cg_pids() {
	local cg
	while IFS= read -r cg; do
		find "$cg" -name cgroup.procs -type f -exec cat {} + 2>/dev/null
	done < <(claude_cgroups)
	return 0
}

# base_job PID   Gehört PID zu einem Job der Grundregel? PID oder ein Vorfahr ist bash mit
#   /usr/local/bin/lf-lesen oder lf-aufgabe als Skript, direkt von sudo gestartet.
base_job() {
	local pid=$1 n=0 r e p s
	local -a a
	while [[ $pid =~ ^[0-9]+$ ]] && ((pid > 1 && n++ < 64)); do
		read -r r e p s <<<"$(st "$pid")"
		a=()
		{ mapfile -d '' -t a <"/proc/$pid/cmdline"; } 2>/dev/null
		if [[ ${a[1]:-} == /usr/local/bin/lf-lesen || ${a[1]:-} == /usr/local/bin/lf-aufgabe ]] &&
			[[ $(prog "$pid") == */bash ]] && is_sudo "$p"; then
			return 0
		fi
		pid=$p
	done
	return 1
}

# setuid_helper PID   Das setuid-Hilfsprogramm von Claude Desktop (chrome-sandbox), das lf-claude
#   ohne sudo startet.
setuid_helper() {
	[[ $(prog "$1") =~ ^/(opt|usr/lib)/[^/]+/chrome-sandbox$ ]]
}

# root_in_claude   Prozesse in den cgroups von Claude, die als root laufen. Nicht dazu zählen sudo
#   selbst (es startet Claude als lf-claude und wartet nur), Jobs von lf-lesen und lf-aufgabe und
#   chrome-sandbox.
root_in_claude() {
	local pid r e p s
	while IFS= read -r pid; do
		read -r r e p s <<<"$(st "$pid")"
		[[ $r =~ ^[0-9]+$ && $e =~ ^[0-9]+$ && $s != Z ]] || continue
		((r == 0 || e == 0)) || continue
		gone "$pid" && continue
		is_sudo "$pid" && continue
		((r != 0)) && setuid_helper "$pid" && continue
		base_job "$pid" && continue
		echo "$pid"
	done < <(cg_pids | sort -un)
	return 0
}

# stop_root_in_claude   KILL für jeden Prozess aus root_in_claude. In einer angehaltenen cgroup
#   wirkt KILL trotzdem, und dort startet vorher nichts Neues mehr. KILL wirkt nicht sofort:
#   Danach wartet es höchstens 2 Sekunden, bis die Prozesse weg sind.
stop_root_in_claude() {
	local pid i
	local -a pids
	mapfile -t pids < <(root_in_claude)
	((${#pids[@]})) || return 0
	for pid in "${pids[@]}"; do
		note "beendet: $pid $(tr '\0' ' ' <"/proc/$pid/cmdline" 2>/dev/null | cut -c1-120)"
		kill -KILL "$pid" 2>/dev/null
	done
	for ((i = 0; i < 20; i++)); do
		[[ -z $(root_in_claude) ]] && return 0
		sleep 0.1
	done
	return 0
}

# cg_freeze 1|0   Hält die cgroups von Claude an oder lässt sie weiterlaufen. Angehaltene
#   Prozesse starten nichts mehr und rufen kein sudo mehr auf.
cg_freeze() {
	local cg i
	while IFS= read -r cg; do
		[[ -e $cg/cgroup.freeze ]] || continue
		echo "$1" >"$cg/cgroup.freeze" 2>/dev/null || continue
		[[ $1 == 1 ]] || continue
		for ((i = 0; i < 30; i++)); do
			grep -qx 'frozen 1' "$cg/cgroup.events" 2>/dev/null && break
			sleep 0.1
		done
	done < <(claude_cgroups)
	return 0
}

# units_now   "EINHEIT INVOCATIONID" je Dienst, Scope, Timer, Socket und Pfad-Einheit, die nicht
#   inaktiv ist. systemd vergibt bei jedem Start eine neue InvocationID: Wird eine Einheit während
#   der Freigabe unter einem Namen von vorher neu angelegt oder neu gestartet, ist sie neu.
units_now() {
	local -a us
	mapfile -t us < <(systemctl list-units --plain --no-legend --full --type=service,scope,timer,socket,path 2>/dev/null |
		awk '$1 ~ /\./ {print $1}' | sort -u)
	((${#us[@]})) || return 0
	systemctl show -p Id -p InvocationID -- "${us[@]}" 2>/dev/null |
		awk '/^Id=/ {id = substr($0, 4)} /^InvocationID=/ {inv = substr($0, 14)}
			/^$/ {if (id != "") print id, inv; id = inv = ""} END {if (id != "") print id, inv}' | sort -u
}

# unit_info EINHEIT   Füllt ui mit den Eigenschaften, die new_units und kept_unit brauchen. Gibt
#   systemctl eine Eigenschaft mehrfach aus (ein Befehl je Zeile), stehen alle Zeilen darin.
declare -A ui
unit_info() {
	local k v
	ui=()
	while IFS='=' read -r k v; do
		[[ -n $k ]] && ui[$k]=${ui[$k]+${ui[$k]}$'\n'}$v
	done < <(systemctl show -p Transient,ActiveState,ControlGroup,FragmentPath,DropInPaths,ExecStart,Type,MainPID \
		-p ExecCondition,ExecStartPre,ExecStartPost,ExecReload,ExecStop,ExecStopPost,UnsetEnvironment \
		-p Environment,EnvironmentFiles,RootDirectory,RootImage,User,OnFailure,OnSuccess,Upholds \
		-p StandardInput,StandardOutput,StandardError,Restart "$1" 2>/dev/null)
	return 0
}

# unit_changed   Ist die Unit-Datei (ui von unit_info) oder eine ihrer Ergänzungen (Drop-ins, auch
#   von systemctl edit --runtime) neuer als das Freischalten? Eine Datei, die es nicht mehr gibt,
#   und ein Pfad, den systemctl nicht ausgibt ("[unprintable]" bei Leerzeichen), zählen als neu.
unit_changed() {
	local f
	local -a fs
	read -ra fs <<<"${ui[FragmentPath]:-} ${ui[DropInPaths]:-}"
	for f in "${fs[@]}"; do
		[[ $f == /* && -e $f && ! $f -nt $SNAP/units ]] || return 0
	done
	return 1
}

# Was an einem Dienst, den das Ende einer Freigabe stehen lässt (kept_unit), leer sein muss: so legt
# systemd-run ihn ohne weitere Angaben an. UnsetEnvironment muss genau ENV_UNSAFE sein.
KEPT_EMPTY=(DropInPaths ExecCondition ExecStartPre ExecStartPost ExecReload ExecStop ExecStopPost
	Environment EnvironmentFiles RootDirectory RootImage User OnFailure OnSuccess Upholds)
# Was genau so sein muss, wie systemd-run es ohne weitere Angaben setzt: Mit einer Datei als Ein-
# oder Ausgabe läse oder schriebe ein Dienst, der bleibt, eine Datei, die root gewählt hat (etwa
# lf-aufgabe), mit Restart= startete er nach dem Ende neu, samt seinen Abhängigkeiten.
KEPT_SAME=(StandardInput=null StandardOutput=journal StandardError=inherit Restart=no)

# unsafe_env PID   Hat PID eine Variable aus ENV_UNSAFE, sonst eine LD_-Variable oder eine Funktion
#   für bash (BASH_FUNC_)? Ist die Umgebung nicht lesbar (ohne root), gilt sie als unsicher,
#   außer PID ist inzwischen beendet.
unsafe_env() {
	local env
	if ! env=$({ tr '\0' '\n' <"/proc/$1/environ"; } 2>/dev/null); then
		[[ -e /proc/$1 ]]
		return
	fi
	grep -qE "^(LD_[^=]*|BASH_FUNC_[^=]*|${ENV_UNSAFE// /|})=" <<<"$env"
}

# env_from_snapshot PID CGROUP   Hat PID nur Variablen, die beim Freischalten genau so in der
#   Umgebung des Managers standen (SNAP/menv), dazu die, die systemd jedem Dienst selbst gibt, und
#   USER=root? MEMORY_PRESSURE_WATCH darf nur die Datei der eigenen cgroup nennen: Programme mit
#   sd-event schreiben MEMORY_PRESSURE_WRITE dorthin. Ein Dienst erbt die Umgebung des Managers,
#   wie sie bei seinem Start war: Hat root während der Freigabe etwa einen eigenen Ordner vorn in
#   PATH gesetzt (systemctl set-environment), setzt das Ende zwar den Manager zurück
#   (menv_restore), der Dienst liefe aber mit den Programmen von root weiter. Ohne Schnappschuss
#   oder lesbare Umgebung: nein.
env_from_snapshot() {
	local bad
	[[ -s $SNAP/menv ]] || return 1
	bad=$(jq -Rrs --slurpfile s "$SNAP/menv" --arg w "MEMORY_PRESSURE_WATCH=/sys/fs/cgroup$2/memory.pressure" '
		def systemd: (split("=")[0]) as $n | if $n == "MEMORY_PRESSURE_WATCH" then . == $w
			else ($n | IN("INVOCATION_ID", "JOURNAL_STREAM", "SYSTEMD_EXEC_PID", "MEMORY_PRESSURE_WRITE")) or . == "USER=root" end;
		split("\u0000")[] | select(length > 0) | select(systemd or IN($s[]) | not) | split("=")[0]' \
		2>/dev/null <"/proc/$1/environ") || return 1
	[[ -z $bad ]]
}

# descends PID VORFAHR   Stammt PID von VORFAHR ab (oder ist es selbst)?
descends() {
	local pid=$1 n=0 r e p s
	while [[ $pid =~ ^[0-9]+$ ]] && ((pid > 1 && n++ < 64)); do
		((pid == $2)) && return 0
		read -r r e p s <<<"$(st "$pid")"
		pid=$p
	done
	return 1
}

# chain_ok   Ist die Kette der Grundregel (CHAIN_DIRS, CHAIN_BINS) seit dem Freischalten unverändert
#   und die Grundregel nicht gesperrt? Erst dann führt kept_unit lf-aufgabe aus.
CHAIN_OK=
chain_ok() {
	if [[ -z $CHAIN_OK ]]; then
		CHAIN_OK=1
		[[ -f $SNAP/chain && -z $(chain_changed) && ! -e $BASE_FILE.lf-gesperrt ]] || CHAIN_OK=0
	fi
	((CHAIN_OK))
}

# kept_unit EINHEIT   Ist EINHEIT genau ein Dienst, den Claude auch ohne Freigabe über die Grundregel
#   bekommt: ntfs-3g für eine Quelle, die lf-aufgabe einhaengen nur lesend eingehängt hat (ntfs3g_ro
#   in recover.sh), oder eine Rettung von lf-aufgabe retten oder fortsetzen (start_rescue in
#   lf-aufgabe)? Solche Dienste bleiben am Ende einer Freigabe: Sonst verschwände die Quelle unter
#   laufenden Jobs, oder eine Rettung bräche ab. Mit root ließe sich aber ein Dienst mit demselben
#   Namen anlegen, der nach dem Ende weiter Code als root ausführt (GHSA-799j-44qx-x7xj). Darum
#   prüft kept_unit für beide Arten dasselbe, nur die Erwartung je Art (Name, Programm, Typ,
#   Argumente) ist eine andere:
#   - die Einheit (ui von unit_info): vorübergehend wie von systemd-run, ohne Drop-ins, genau ein
#     Befehl, alles aus KEPT_EMPTY leer, KEPT_SAME wie von systemd-run, UnsetEnvironment genau
#     ENV_UNSAFE;
#   - die Argumente: bei ntfs-3g Optionen, Quelle und Einhängepunkt wie in ntfs3g_ro und der Name
#     zum Einhängepunkt; bei einer Rettung der Name zum Fallordner, und lf-aufgabe selbst prüft
#     Fallordner und Quelle wie bei retten (nur mit unveränderter Kette, chain_ok);
#   - der Hauptprozess: genau dieses Programm mit genau diesen Argumenten, mit derselben Wurzel und
#     denselben Einhängungen wie systemd und nur mit der Umgebung des Managers vom Freischalten
#     (env_from_snapshot); kein Prozess im Dienst mit einer Variablen, die fremden Code lädt
#     (unsafe_env).
#   Jeder Prozess im Dienst (auch in einer Unter-cgroup) muss vom Hauptprozess abstammen. Andere
#   stehen danach in KEPT_FOREIGN,
#   stop_new_units beendet sie. Prozesse prüfen kann nur root. Was root an einem laufenden Prozess
#   geändert hat (etwa mit ptrace), sieht keine Prüfung: Sicher ist nur ein Neustart.
KEPT_FOREIGN=()
kept_unit() {
	local u=$1 kind re path exe pid p n src list
	local -a argv want cmd procs
	KEPT_FOREIGN=()
	case $u in
	lf-ntfs3g-*.service) kind=ntfs3g ;;
	lf-claude-rettung-*.service) kind=rettung ;;
	*) return 1 ;;
	esac
	[[ ${ui[Transient]:-} == yes && ${ui[FragmentPath]:-} == "/run/systemd/transient/$u" ]] || return 1
	[[ ${ui[UnsetEnvironment]:-} == "$ENV_UNSAFE" ]] || return 1
	for p in "${KEPT_EMPTY[@]}"; do
		[[ -z ${ui[$p]:-} ]] || return 1
	done
	for p in "${KEPT_SAME[@]}"; do
		[[ ${ui[${p%%=*}]:-} == "${p#*=}" ]] || return 1
	done
	re='^[{] path=([^ ]+) ; argv[[][]]=(.*) ; ignore_errors=no ; '
	[[ ${ui[ExecStart]:-} =~ $re && ${ui[ExecStart]} != *$'\n'* ]] || return 1
	path=${BASH_REMATCH[1]}
	read -ra argv <<<"${BASH_REMATCH[2]}"
	[[ ${argv[0]:-} == "$path" ]] || return 1
	case $kind in
	ntfs3g)
		[[ ${ui[Type]:-} == forking && ($path == /usr/bin/ntfs-3g || $path == /bin/ntfs-3g) ]] || return 1
		[[ ${#argv[@]} == 5 && ${argv[1]} == -o && ${argv[2]} == ro,nodev,nosuid,noexec,recover && ${argv[3]} == /dev/?* ]] || return 1
		re="^$IMAGE_MNT/[a-z0-9][a-z0-9-]{0,63}$"
		[[ ${argv[4]} =~ $re ]] || return 1
		[[ $u == "lf-ntfs3g-$(systemd-escape --path -- "${argv[4]}").service" ]] || return 1
		src=$(scan readlink -f -- "${argv[3]}") && [[ $src == /dev/?* && -e $SYS_BLOCK/${src##*/} ]] || return 1
		exe=$NTFS3G want=("${argv[@]}")
		;;
	rettung)
		# start_rescue: lf-rescue-run FALLORDNER QUELLE --no-pause (LF_TECHNIKER kommt über sudo nicht an).
		[[ ${ui[Type]:-} == simple && $path == "$RESCUE_RUN" && ${#argv[@]} == 4 && ${argv[3]} == --no-pause ]] || return 1
		[[ $u == "lf-claude-rettung-$(printf '%s' "${argv[1]}" | sha256sum | cut -c1-12).service" ]] || return 1
		# Das Skript beginnt mit "#!/usr/bin/env bash": Es läuft als bash mit dem Skript davor.
		exe=$BASH_EXE want=(bash "${argv[@]}")
		;;
	esac
	pid=${ui[MainPID]:-0}
	[[ $pid =~ ^[1-9][0-9]*$ ]] || return 1
	[[ /proc/$pid/exe -ef $exe && /proc/$pid/root/ -ef / && /proc/$pid/ns/mnt -ef /proc/1/ns/mnt ]] || return 1
	{ mapfile -d '' -t cmd <"/proc/$pid/cmdline"; } 2>/dev/null || return 1
	((${#cmd[@]} == ${#want[@]})) || return 1
	for ((n = 0; n < ${#want[@]}; n++)); do
		[[ ${cmd[n]} == "${want[n]}" ]] || return 1
	done
	# Alle Prozesse im Dienst, auch in Unter-cgroups: Die kann root darin anlegen, systemd legt bei
	# diesen Diensten keine an.
	[[ ${ui[ControlGroup]:-} == /?* && -f $CGROOT${ui[ControlGroup]}/cgroup.procs ]] || return 1
	list=$(scan find "$CGROOT${ui[ControlGroup]}" -xdev -name cgroup.procs -type f -exec cat {} + 2>/dev/null) || return 1
	mapfile -t procs <<<"$list"
	[[ " ${procs[*]} " == *" $pid "* ]] || return 1
	unsafe_env "$pid" && return 1
	env_from_snapshot "$pid" "${ui[ControlGroup]}" || return 1
	for p in "${procs[@]}"; do
		# Ein Prozess, der inzwischen beendet ist, zählt nicht.
		[[ $p =~ ^[0-9]+$ && $p != "$pid" ]] || continue
		gone "$p" && continue
		unsafe_env "$p" && return 1
		descends "$p" "$pid" || KEPT_FOREIGN+=("$p")
	done
	if [[ $kind == rettung ]]; then
		chain_ok || return 1
		scan "$AUFGABE" pruefen-rettung "${argv[1]}" "${argv[2]}" </dev/null >/dev/null 2>&1 || return 1
	fi
	return 0
}

# new_units   Laufende Einheiten, die seit dem Freischalten entstanden oder neu gestartet sind
#   (eine InvocationID, die es beim Freischalten nicht gab, auch unter einem Namen von vorher):
#   vorübergehende (systemd-run) und solche aus einer Unit-Datei, die selbst oder deren Ergänzung
#   neuer ist als das Freischalten (unit_changed). Ausgabe "EINHEIT" je Einheit zum Beenden und
#   "EINHEIT PID" je fremdem Prozess in einem Dienst, der bleibt. Nicht dazu zählen die eigenen
#   Einheiten, die Dienste der Grundregel (kept_unit: ntfs-3g für nur lesend eingehängte Quellen,
#   Rettungen von lf-aufgabe), die Sitzungen von Claude selbst (claude_scope) und Anmeldungen von
#   Benutzern außer root (der Techniker an tty2 oder über SSH). root-Prozesse in den cgroups von
#   Claude beendet stop_root_in_claude.
new_units() {
	local u p
	[[ -f $SNAP/units ]] || return 0
	while read -r u _; do
		# Der eigene Timer (off stoppt ihn) und der Dienst, in dem dieses Ende selbst läuft.
		[[ $u == "$UNIT.timer" ]] && continue
		[[ ($u == "$UNIT.service" || $u == "$UNIT-aus.service") && $(sed -n 's/^0:://p' /proc/self/cgroup 2>/dev/null) == */"$u" ]] && continue
		unit_info "$u"
		case ${ui[ActiveState]:-} in inactive | failed | "") continue ;; esac
		if [[ ${ui[Transient]:-} != yes ]]; then
			unit_changed || continue
		fi
		if kept_unit "$u"; then
			for p in "${KEPT_FOREIGN[@]}"; do echo "$u $p"; done
			continue
		fi
		[[ $u == *.scope && ${ui[ControlGroup]:-} == /lf.slice/lf-claude.slice/* ]] && continue
		[[ $u == session-*.scope && ${ui[ControlGroup]:-} =~ ^/user\.slice/user-([0-9]+)\.slice/ && ${BASH_REMATCH[1]} != 0 ]] && continue
		echo "$u"
	done < <(comm -13 "$SNAP/units" <(units_now))
	return 0
}

# stop_new_units   Hält jede Einheit aus new_units an, beendet ihre Prozesse und stoppt sie; einen
#   fremden Prozess in einem Dienst, der bleibt, beendet es allein. Neue, die eine davon noch
#   gestartet hat, folgen in der nächsten Runde.
stop_new_units() {
	local i u p
	local -a ls
	for ((i = 0; i < 5; i++)); do
		mapfile -t ls < <(new_units)
		((${#ls[@]})) || return 0
		for u in "${ls[@]}"; do
			if [[ $u == *" "* ]]; then
				p=${u##* } u=${u% *}
				note "beendet: $p $(tr '\0' ' ' <"/proc/$p/cmdline" 2>/dev/null | cut -c1-120) (fremd in $u)"
				kill -KILL "$p" 2>/dev/null
				continue
			fi
			note "beendet: Einheit $u"
			systemctl freeze "$u" 2>/dev/null
			systemctl kill -s KILL "$u" 2>/dev/null
			systemctl stop "$u" 2>/dev/null
			systemctl reset-failed "$u" 2>/dev/null
		done
	done
	return 0
}

# at_now   Nummern der at-Aufträge (leer ohne at; im Rettungssystem ist at nicht installiert).
at_now() {
	command -v atq >/dev/null || return 0
	atq 2>/dev/null | awk '{print $1}' | sort -u
}

# stop_new_at   Entfernt at-Aufträge, die während der Freigabe entstanden sind.
stop_new_at() {
	local j
	[[ -f $SNAP/at ]] || return 0
	while IFS= read -r j; do
		[[ -n $j ]] || continue
		note "entfernt: at-Auftrag $j"
		atrm "$j" 2>/dev/null
	done < <(comm -13 "$SNAP/at" <(at_now))
	return 0
}

# cron_files   "PFAD ÄNDERUNGSZEIT" je cron-Datei (im Rettungssystem ist cron nicht installiert).
cron_files() {
	scan find "${CRON_PATHS[@]}" -maxdepth 1 -type f -printf '%p %T@\n' 2>/dev/null | sort
}

# cron_new   cron-Dateien, die seit dem Freischalten entstanden oder geändert sind.
cron_new() {
	[[ -f $SNAP/cron ]] || return 0
	comm -13 "$SNAP/cron" <(cron_files) | cut -d' ' -f1 | grep -v '\.lf-gesperrt$'
	return 0
}

# disable_new_cron   Neue oder geänderte cron-Dateien bekommen die Endung .lf-gesperrt; cron liest
#   Namen mit Punkt nicht. Gelöscht wird nichts. Eine geänderte /etc/crontab bleibt und steht im
#   Rückstand.
disable_new_cron() {
	local f
	while IFS= read -r f; do
		[[ -n $f && $f != */crontab ]] || continue
		mv -f -- "$f" "$f.lf-gesperrt" 2>/dev/null && note "gesperrt: cron-Datei $f"
	done < <(cron_new)
	return 0
}

# sudo_files   "PFAD ÄNDERUNGSZEIT GRÖSSE" für /etc/sudoers und jede Datei in /etc/sudoers.d, die
#   sudo liest (keine Namen mit Punkt oder Tilde am Ende), ohne die Regel der Freigabe.
sudo_files() {
	scan find "$SUDOERS" "${SUDOERS_D%/}" -maxdepth 1 \( -type f -o -type l \) -printf '%p %T@ %s\n' 2>/dev/null |
		awk -v rule="$RULE" -v d="$SUDOERS_D" '{
			if ($1 == rule) next
			if (index($1, d) == 1) { n = substr($1, length(d) + 1); if (n ~ /\./ || n ~ /~$/) next }
			print
		}' | sort
}

# menv   Die Umgebung des systemd-Managers, die jeder Dienst erbt: je Variable eine Zeile, der
#   Text "NAME=WERT" als JSON (genau wie systemd ihn hält, auch mit Sonderzeichen), sortiert.
#   Rückgabe 1, wenn systemd nicht antwortet.
menv() {
	local out
	out=$(busctl --json=short get-property org.freedesktop.systemd1 /org/freedesktop/systemd1 \
		org.freedesktop.systemd1.Manager Environment 2>/dev/null | jq -r '.data[] | @json' 2>/dev/null) || return 1
	[[ -n $out ]] || return 1
	sort <<<"$out"
}

# menv_names   Die Namen aus Zeilen von menv, sortiert.
menv_names() {
	jq -r 'split("=")[0]' 2>/dev/null | sort -u
}

# menv_changed   Namen der Variablen, die seit dem Freischalten neu, geändert oder weg sind.
menv_changed() {
	local now
	[[ -e $SNAP/menv ]] || return 0
	# Leer, wenn systemd beim Freischalten nicht antwortete (snapshot): Dann ist nichts zu vergleichen.
	[[ -s $SNAP/menv ]] || { echo "(beim Freischalten nicht lesbar)"; return 0; }
	now=$(menv) || { echo "(nicht lesbar)"; return 0; }
	comm -3 "$SNAP/menv" <(echo "$now") | sed 's/^\t//' | menv_names
}

# menv_restore   Setzt die Umgebung des Managers auf den Stand beim Freischalten zurück: neue
#   Variablen fort, geänderte und entfernte wieder wie damals (etwa LD_PRELOAD mit systemctl
#   set-environment). Ins Protokoll kommen nur die Namen. Was sich nicht zurücksetzen lässt,
#   meldet residue.
menv_restore() {
	local now names ok=1
	local -a gone back
	[[ -s $SNAP/menv ]] || return 0
	now=$(menv) || return 0
	mapfile -t gone < <(comm -13 <(menv_names <"$SNAP/menv") <(menv_names <<<"$now"))
	mapfile -d '' -t back < <(comm -23 "$SNAP/menv" <(echo "$now") | jq -j '., "\u0000"' 2>/dev/null)
	((${#gone[@]} + ${#back[@]})) || return 0
	if ((${#gone[@]})); then systemctl unset-environment -- "${gone[@]}" 2>/dev/null || ok=0; fi
	if ((${#back[@]})); then systemctl set-environment -- "${back[@]}" 2>/dev/null || ok=0; fi
	names=$({ printf '%s\n' "${gone[@]}"; printf '%s\n' "${back[@]%%=*}"; } | sed '/^$/d' | sort -u | tr '\n' ' ')
	if ((ok)); then
		note "Manager-Umgebung zurückgesetzt: $names"
	else
		note "Manager-Umgebung ließ sich nicht zurücksetzen: $names"
	fi
}

# files_now   "ÄNDERUNGSZEIT GRÖSSE PFAD" je Datei und Ordner in WATCH, sortiert. Es zählt die
#   ctime: Die setzt nur der Kernel, touch kann sie nicht zurückstellen. Zeilenumbrüche in Namen
#   werden zu "?".
files_now() {
	scan find "${WATCH[@]}" -printf '%C@ %s %p\0' 2>/dev/null | tr '\n\0' '?\n' | sort
}

# files_changed   "Datei neu|geändert|entfernt: PFAD" für jeden Eintrag aus WATCH, der seit dem
#   Freischalten neu, geändert oder weg ist.
files_changed() {
	[[ -f $SNAP/files ]] || return 0
	files_now | awk -v snap="$SNAP/files" '
		function path(l) { sub(/^[^ ]* [^ ]* /, "", l); return l }
		BEGIN { while ((getline l < snap) > 0) old[path(l)] = l }
		{ p = path($0); now[p] = $0 }
		END {
			for (p in now) if (!(p in old)) print "Datei neu: " p; else if (old[p] != now[p]) print "Datei geändert: " p
			for (p in old) if (!(p in now)) print "Datei entfernt: " p
		}' | sort
}

# disable_preload   Eine /etc/ld.so.preload, die seit dem Freischalten neu ist oder sich geändert hat,
#   bekommt die Endung .lf-gesperrt: Der Lader lädt dann ihre Bibliothek nicht mehr in jedes
#   Programm, auch nicht in sudo. Gelöscht wird nichts, residue meldet sie (files_changed).
disable_preload() {
	local old now
	[[ -f $SNAP/files && (-e $PRELOAD || -L $PRELOAD) ]] || return 0
	old=$(awk -v p="$PRELOAD" '{q = $0; sub(/^[^ ]* [^ ]* /, "", q)} q == p' "$SNAP/files")
	now=$(scan find "$PRELOAD" -maxdepth 0 -printf '%C@ %s %p' 2>/dev/null)
	[[ -n $old && $now == "$old" ]] && return 0
	mv -f -- "$PRELOAD" "$PRELOAD.lf-gesperrt" 2>/dev/null && note "gesperrt: $PRELOAD"
	return 0
}

# chain_now   Je Datei der Kette eine Zeile "MERKMAL  PFAD", sortiert: für gewöhnliche Dateien bis
#   16 MiB die SHA256-Summe, für größere (die Claude-CLI) Größe und ctime, für eine Verknüpfung ihr
#   Ziel als Text (ihm wird nicht gefolgt), sonst die Art (FIFO, Gerät, Ordner in CHAIN_BINS).
#   Gelesen werden nur gewöhnliche Dateien: Eine Verknüpfung auf /dev/zero oder ein FIFO hielte
#   das Ende sonst auf. Kette: CHAIN_BINS, für eine Verknüpfung dort auch die Datei, auf die sie
#   am Ende zeigt (auf dem ISO /usr/bin/sudo -> /etc/alternatives/sudo -> /usr/lib/cargo/bin/sudo
#   und /usr/bin/env -> ../lib/cargo/bin/coreutils/env), und jede Datei unter CHAIN_DIRS. Bricht
#   sha256sum ab, fehlen Summen: Das zählt wie geändert.
chain_now() {
	local b r
	local -a bins=("${CHAIN_BINS[@]}") files=()
	for b in "${CHAIN_BINS[@]}"; do
		r=$(scan readlink -f -- "$b" 2>/dev/null) && [[ -n $r && $r != "$b" ]] && bins+=("$r")
	done
	mapfile -d '' -t files < <(
		scan find "${bins[@]}" -maxdepth 0 -type f -size -16384k -print0 2>/dev/null
		scan find "${CHAIN_DIRS[@]}" -type f -size -16384k -print0 2>/dev/null
	)
	{
		((${#files[@]})) && scan sha256sum -- "${files[@]}" 2>/dev/null
		scan find "${bins[@]}" -maxdepth 0 \( -type f -size +16383k -printf 'gross:%s:%C@  %p\n' \) -o \( ! -type f -printf 'art:%y:%l  %p\n' \) 2>/dev/null
		scan find "${CHAIN_DIRS[@]}" -mindepth 1 \( -type f -size +16383k -printf 'gross:%s:%C@  %p\n' \) -o \( ! -type f ! -type d -printf 'art:%y:%l  %p\n' \) 2>/dev/null
	} | tr '\t' ' ' | sort
}

# chain_changed   Je Zeile eine Datei der Kette, die seit dem Freischalten neu, geändert oder weg ist.
chain_changed() {
	[[ -f $SNAP/chain ]] || return 0
	comm -3 "$SNAP/chain" <(chain_now) | sed -E 's/^\t//; s/^[^ ]+ [ *]//' | sort -u
}

# check_chain   Hat sich an der Kette der Grundregel etwas geändert, wäre lf-aufgabe oder ein Programm
#   darunter nicht mehr das von vorher: Die Datei der Grundregel bekommt die Endung .lf-gesperrt,
#   sudo liest sie bis zum Neustart nicht mehr (/etc liegt im RAM). Danach lässt kept_unit auch
#   keine Rettung mehr stehen.
check_chain() {
	local c
	CHAIN_OK=
	c=$(chain_changed)
	[[ -n $c ]] || return 0
	note "geändert seit dem Freischalten: ${c//$'\n'/, }"
	[[ -e $BASE_FILE ]] && mv -f -- "$BASE_FILE" "$BASE_FILE.lf-gesperrt" 2>/dev/null &&
		note "gesperrt: Grundregel von $CLAUDE ($BASE_FILE) bis zum Neustart"
	CHAIN_OK=0
	return 0
}

# suid_roots   Einhängepunkte im Mount-Namensraum von PID 1, auf die sich schreiben lässt und die
#   setuid zulassen (weder ro noch nosuid): die Wurzel und, je nach System, weitere.
suid_roots() {
	local m
	while IFS= read -r m; do
		printf '%b\n' "$m"
	done < <(awk '{n = split($6, o, ","); w = 1; for (i = 1; i <= n; i++) if (o[i] == "ro" || o[i] == "nosuid") w = 0; if (w) print $5}' /proc/1/mountinfo 2>/dev/null)
}

# fs_new   Was sich seit dem Freischalten auf einem Dateisystem aus suid_roots geändert hat (ctime
#   nach dem Freischalten): je Zeile eine Datei mit setuid, setgid oder capabilities (eine Kopie
#   einer Shell mit setuid gäbe lf-claude root, ohne dass ein Prozess läuft) und jede Datei oder
#   Verknüpfung unter /usr (Programme, Bibliotheken, PAM- und NSS-Module, D-Bus-Dienste; dort
#   ändert sich ohne Paketinstallation nichts).
fs_new() {
	local t m p i rc
	local -a roots=() files=()
	[[ -f $SNAP/zeit ]] || return 0
	mapfile -t roots < <(suid_roots)
	((${#roots[@]})) || return 0
	while IFS=' ' read -r -d '' t m p; do
		if [[ $t == rc ]]; then
			# 1: einzelne Dateien nicht lesbar oder verschwunden; mehr: abgebrochen (scan).
			[[ $m =~ ^[01]$ ]] || echo "Suche nach setuid und in /usr abgebrochen (rc $m)"
			continue
		fi
		[[ $m =~ ^[0-7]+$ ]] || continue
		if [[ $p == "$WROOT"/usr/* ]]; then echo "Systemdatei neu oder geändert: ${p//$'\n'/?}"; fi
		[[ $t == f ]] || continue
		((8#$m & 06000)) && echo "setuid/setgid: ${p//$'\n'/?}"
		files+=("$p")
	done < <(scan find "${roots[@]}" -xdev \( -type f -o -type l \) -cnewer "$SNAP/zeit" -printf '%y %m %p\0' 2>/dev/null; echo "rc $?" | tr '\n' '\0')
	# getcap direkt unter scan, je 500 Dateien.
	for ((i = 0; i < ${#files[@]}; i += 500)); do
		scan getcap "${files[@]:i:500}" 2>/dev/null | sed 's/^/capabilities: /'
		rc=${PIPESTATUS[0]}
		((rc == 124 || rc == 137)) && echo "Suche nach capabilities abgebrochen (rc $rc)"
	done
	return 0
}

# knobs_now   "PFAD=WERT" je Kernel-Einstellung aus KNOBS und je Eintrag in binfmt_misc, sortiert.
knobs_now() {
	local f
	for f in "${KNOBS[@]}" "$BINFMT"/*; do
		[[ -f $f && ${f##*/} != register ]] || continue
		printf '%s=%s\n' "$f" "$(scan head -c 4096 -- "$f" 2>/dev/null | tr '\n\0' '  ')"
	done | sort
}

# knobs_changed   Je Zeile eine Kernel-Einstellung oder ein binfmt_misc-Eintrag, der seit dem
#   Freischalten neu, geändert oder weg ist.
knobs_changed() {
	[[ -f $SNAP/knobs ]] || return 0
	comm -3 "$SNAP/knobs" <(knobs_now) | sed -E 's/^\t//; s/=.*//' | sort -u
}

# mounts_now   Die Einhängungen im Mount-Namensraum von PID 1, je eine Zeile aus mountinfo, sortiert.
mounts_now() {
	sort /proc/1/mountinfo 2>/dev/null
}

# mounts_changed   Je Zeile eine Einhängung, die seit dem Freischalten neu ist oder sich geändert hat,
#   auch nur in ihren Optionen. Jede zählt, auch mit nosuid: Eine Einhängung über eine Datei
#   (etwa über lf-lesen) wirkt auch von dort. Ausgenommen sind nur Quellen, wie lf-aufgabe
#   einhaengen sie einhängt: ein Gerät unter IMAGE_MNT/NAME, nur lesend, ohne setuid, Geräte und
#   Ausführen, kein Teil eines anderen Dateisystems (Wurzel /).
mounts_changed() {
	[[ -f $SNAP/mounts ]] || return 0
	comm -13 "$SNAP/mounts" <(mounts_now) | awk -v img="$IMAGE_MNT" '{
		for (i = 7; i <= NF && $i != "-"; i++) ;
		n = split($6, o, ","); delete f; for (k = 1; k <= n; k++) f[o[k]] = 1
		if ($4 == "/" && $5 ~ ("^" img "/[a-z][a-z0-9]*$") && length($5) <= length(img) + 33 && $(i + 2) ~ /^\/dev\// &&
			("ro" in f) && ("nosuid" in f) && ("nodev" in f) && ("noexec" in f)) next
		print "Einhängung neu oder geändert: " $5 " (" $(i + 1) " " $(i + 2) ")"
	}'
}

# snapshot   Hält fest, was es beim Freischalten schon gab. Neu ist, was danach dazukommt.
snapshot() {
	install -d -m 0755 "$SNAP"
	# Bezug für die ctime in fs_new: Die Datei entsteht jetzt.
	rm -f "$SNAP/zeit" && : >"$SNAP/zeit"
	units_now >"$SNAP/units"
	at_now >"$SNAP/at"
	cron_files >"$SNAP/cron"
	sudo_files >"$SNAP/sudoers"
	menv >"$SNAP/menv" || : >"$SNAP/menv"
	files_now >"$SNAP/files"
	chain_now >"$SNAP/chain"
	# Vor den Einhängungen: binfmt_misc ist oft eine Automount-Stelle, die erst das Lesen einhängt.
	knobs_now >"$SNAP/knobs"
	mounts_now >"$SNAP/mounts"
	chmod 0644 "$SNAP"/*
}

# quick_residue   Je Zeile ein Weg zu root, den lf-claude ohne die Regel noch hat, soweit ihn jeder
#   sehen kann. status läuft auch als lf-claude und als Techniker.
quick_residue() {
	local f l groups procs units="" fremd=""
	# Ohne den Benutzer lf-claude gibt es auch keinen Weg zu root für ihn.
	id -u "$CLAUDE" >/dev/null 2>&1 || return 0
	if [[ -f $SNAP/sudoers ]]; then
		while IFS= read -r f; do
			[[ -n $f ]] && echo "sudo-Datei neu oder geändert: ${f%% *}"
		done < <(comm -13 "$SNAP/sudoers" <(sudo_files))
	fi
	groups=$(id -Gn "$CLAUDE" 2>&1 | tr ' ' '\n' | sort | tr '\n' ' ')
	[[ $groups == "lf-claude render " ]] || echo "Gruppen: $groups"
	[[ -e $LINGER/$CLAUDE ]] && echo "linger: $CLAUDE"
	procs=$(root_in_claude | tr '\n' ' ')
	[[ -z $procs ]] || echo "root-Prozesse bei Claude: $procs"
	while IFS= read -r l; do
		if [[ $l == *" "* ]]; then fremd+="${l##* } (${l% *}) "; else units+="$l "; fi
	done < <(new_units)
	[[ -z $units ]] || echo "Einheiten: $units"
	[[ -z $fremd ]] || echo "fremde Prozesse in Diensten: $fremd"
	return 0
}

# residue   Leer, wenn lf-claude nur die Grundregel hat, sonst je Zeile ein Fund. Läuft als root.
#   Wer mit der Freigabe root war, kann sich weitere Wege eingerichtet haben. residue prüft die
#   naheliegenden, nicht alle: Sicher ist nur ein Neustart. Dazu gehören Wege ohne laufenden
#   Prozess: geänderte Werkzeuge der Grundregel, Dateien aus WATCH, setuid-Dateien und /usr,
#   Kernel-Einstellungen, Einhängungen und die Umgebung des Managers.
residue() {
	local rules procs c
	rules=$(sudo -l -U "$CLAUDE" 2>&1 | sed -nE 's/^[[:space:]]+(\(.*)$/\1/p')
	if [[ -e $BASE_FILE.lf-gesperrt ]]; then
		echo "Grundregel gesperrt bis zum Neustart: $BASE_FILE.lf-gesperrt"
		[[ -z $rules ]] || echo "sudo: ${rules//$'\n'/, }"
	else
		[[ $rules == "$BASE_RULE" ]] || echo "sudo: ${rules//$'\n'/, }"
	fi
	quick_residue
	procs=$(granted_pids | tr '\n' ' ')
	[[ -z $procs ]] || echo "Prozesse: $procs"
	c=$(cron_new | tr '\n' ' ')
	[[ -z $c ]] || echo "cron: $c"
	chain_changed | sed 's/^/Werkzeug neu oder geändert: /'
	files_changed
	fs_new
	knobs_changed | sed 's/^/Kernel-Einstellung neu oder geändert: /'
	mounts_changed
	menv_changed | sed 's/^/Manager-Umgebung: /'
	return 0
}

# timer_end   Ende der Freigabe in Sekunden seit 1970, aus dem Timer. Der zählt monoton, systemd
#   rechnet das Ende mit der aktuellen Uhr aus, auch wenn sie sich nach dem Freischalten
#   umgestellt hat (NTP nach dem Start). Ohne Timer: Rückgabe 1.
timer_end() {
	local next
	next=$(systemctl list-timers --all -o json "$UNIT.timer" 2>/dev/null | jq -r '.[0].next // empty' 2>/dev/null)
	[[ $next =~ ^[0-9]+$ ]] && ((next > 0)) || return 1
	echo $((next / 1000000))
}

# status   "an", solange die Regel besteht. Ohne Regel nur "aus", wenn auch kein Timer mehr läuft
#   und kein anderer Weg zu root zu sehen ist. Keine Prüfung findet jeden Weg: Nach einer Freigabe
#   heißt es bis zum Neustart "aus, Neustart empfohlen (letzte Freigabe bis HH:MM)".
status() {
	local end r t
	if [[ -e $RULE ]]; then
		if end=$(timer_end); then
			echo "an bis $(date -d "@$end" +%H:%M)"
		else
			echo "an, ohne Ablauf"
		fi
		return 0
	fi
	# "-" am Schluss: Bricht eine Prüfung ab (set -u), fehlt es, und das zählt als Rückstand.
	r=$({
		[[ -s $RESIDUE ]] && head -n 1 "$RESIDUE"
		end=$(timer_end) && echo "Regel fehlt, Timer bis $(date -d "@$end" +%H:%M)"
		quick_residue && echo -
	} | head -n 1)
	case $r in
	-) r="" ;;
	"") r="Prüfung abgebrochen" ;;
	esac
	if [[ -n $r ]]; then
		echo "an: Rückstand nach der Freigabe ($r), Neustart empfohlen"
	elif [[ -e $LAST ]]; then
		t=$(head -c 20 "$LAST" 2>/dev/null)
		if [[ $t =~ ^[0-9]+$ ]]; then
			echo "aus, Neustart empfohlen (letzte Freigabe bis $(date -d "@$t" +%H:%M))"
		else
			echo "aus, Neustart empfohlen"
		fi
	else
		echo "aus"
	fi
}

# is_off STATUS   Hat Claude kein root mehr, soweit lf-freigabe es sieht ("aus", auch mit dem
#   Hinweis auf einen Neustart)?
is_off() {
	[[ $1 == aus || $1 == "aus, "* ]]
}

# confirm MINUTEN STATUS   Rückfrage an der Konsole: Verlängern gilt nur, wenn dort "j" getippt
#   wird. Ohne Terminal (systemd-run, Pipe) gibt es keine Antwort, also auch keine Verlängerung.
confirm() {
	local answer=""
	{
		printf '\nClaude hat noch root (%s).\nFreigabe für %s Minuten ab jetzt? [j/N] ' "$2" "$1" >>"$TTY" &&
			read -r -t 60 answer <"$TTY"
	} 2>/dev/null || return 1
	[[ $answer == [jJ] || $answer == [jJ][aA] ]]
}

off() {
	local r had=0
	# Gab es eine Freigabe? Dann empfiehlt status danach einen Neustart (LAST).
	[[ -e $RULE || -e $UNTIL || (-e $SNAP/units && ! -e $LAST) ]] && had=1
	trap 'cg_freeze 0' EXIT
	# Erst anhalten, dann sofort die Regel nehmen, dann aufräumen: In der angehaltenen cgroup
	# startet zwischen Suchen und Beenden nichts Neues. Hängt das Stoppen einer Einheit (etwa an
	# einer hängenden Disk), gilt die Regel trotzdem nicht mehr.
	cg_freeze 1
	trace "Ende der Freigabe: Claude angehalten"
	rm -f "$RULE" "$UNTIL"
	trace "Ende der Freigabe: Regel entfernt"
	# Was jedes Programm lädt und was die Grundregel ausführt, vor allem anderen: Danach läuft keine
	# Bibliothek aus ld.so.preload mehr mit und kein geändertes lf-aufgabe.
	disable_preload
	check_chain
	stop_new_units
	stop_new_at
	disable_new_cron
	systemctl stop "$UNIT.timer" 2>/dev/null || true
	stop_root_in_claude
	stop_granted
	menv_restore
	if [[ -e $LINGER/$CLAUDE ]]; then loginctl disable-linger "$CLAUDE" 2>/dev/null || true; fi
	cg_freeze 0
	trap - EXIT
	trace "Ende der Freigabe: Claude läuft weiter"
	# "ENDE" am Schluss: Bricht eine Prüfung ab (set -u), fehlt es, und das zählt als Rückstand.
	r=$(residue && echo ENDE)
	if [[ $r == ENDE || $r == *$'\n'ENDE ]]; then
		r=${r%ENDE}
		r=${r%$'\n'}
	else
		r+=${r:+$'\n'}"Prüfung des Rückstands abgebrochen"
	fi
	if [[ -n $r ]]; then
		install -d /run/lf
		printf '%s\n' "$r" >"$RESIDUE"
		chmod 0644 "$RESIDUE"
		note "WARNUNG: lf-claude darf nach der Freigabe noch mehr als lf-lesen und lf-aufgabe: ${r//$'\n'/; }. Neustart empfohlen"
	else
		rm -f "$RESIDUE"
		# Sauber zu Ende: Einheiten, die von jetzt an entstehen (etwa systemd-run für ein neues
		# "an"), kommen nicht aus der Freigabe und zählen ohne den Schnappschuss nicht als
		# Rückstand; status fragt systemd dann auch nicht mehr nach jeder Einheit. Ebenso
		# spätere Änderungen an Dateien, Werkzeugen, Einhängungen und der Manager-Umgebung (ein
		# weiteres "aus" sperrte sonst die Grundregel). Bei einem Rückstand bleibt er, das nächste
		# Ende prüft weiter dagegen.
		rm -f "$SNAP/units" "$SNAP/files" "$SNAP/chain" "$SNAP/knobs" "$SNAP/mounts" "$SNAP/menv" "$SNAP/zeit"
	fi
	if ((had)); then
		install -d /run/lf
		date +%s >"$LAST" && chmod 0644 "$LAST"
	fi
	return 0
}

case ${1:-} in
an)
	((EUID == 0)) || { echo "lf-freigabe: nur mit sudo" >&2; exit 2; }
	if caller_from_claude; then
		note "abgelehnt: Freischalten aus der Sitzung von lf-claude" >/dev/null
		echo "lf-freigabe: Die Freigabe schaltet nur der Techniker frei." >&2
		exit 2
	fi
	min=${2:-30}
	[[ $min =~ ^[0-9]{1,3}$ ]] && ((10#$min >= 1 && 10#$min <= 240)) || { echo "lf-freigabe: MINUTEN 1 bis 240" >&2; exit 2; }
	min=$((10#$min))
	s=$(status)
	if ! is_off "$s"; then
		# Claude hat root und könnte selbst verlängern: nur an der Konsole und mit Rückfrage dort.
		if ! caller_on_console; then
			note "abgelehnt: Verlängern nicht von einer Konsole des Geräts ($s)" >/dev/null
			echo "lf-freigabe: Solange Claude root hat ($s), verlängert nur der Techniker an einer Konsole des Geräts (tty1 bis tty63), nicht über SSH, tmux oder systemd-run." >&2
			exit 2
		fi
		if ! confirm "$min" "$s"; then
			note "abgelehnt: Verlängern ohne Bestätigung an der Konsole ($s)" >/dev/null
			echo "lf-freigabe: Nicht verlängert." >&2
			exit 2
		fi
	fi
	install -d /run/lf
	if is_off "$s" || [[ ! -f $SNAP/units ]]; then snapshot; fi
	tmp=$(mktemp /etc/sudoers.d/.lf-claude-freigabe.XXXXXX)
	echo "lf-claude ALL=(ALL:ALL) NOPASSWD: ALL" >"$tmp"
	chmod 0440 "$tmp"
	visudo -cqf "$tmp" || { rm -f "$tmp"; echo "lf-freigabe: sudo-Regel ungültig" >&2; exit 1; }
	mv -f "$tmp" "$RULE"
	echo $(($(date +%s) + min * 60)) >"$UNTIL"
	cp -f "$UNTIL" "$LAST"
	chmod 0644 "$UNTIL" "$LAST"
	systemctl stop "$UNIT.timer" 2>/dev/null || true
	systemctl reset-failed "$UNIT.timer" "$UNIT.service" 2>/dev/null || true
	# Type=oneshot: Wer den Dienst von Hand startet, kehrt erst zurück, wenn die Freigabe weg ist.
	systemd-run --quiet --unit="$UNIT" --on-active="${min}min" --timer-property=AccuracySec=1s -p Type=oneshot \
		-p UnsetEnvironment="$ENV_UNSAFE" /usr/local/bin/lf-freigabe ablauf || { off; echo "lf-freigabe: Timer ließ sich nicht setzen, Freigabe zurückgenommen" >&2; exit 1; }
	end=$(timer_end) || end=$(cat "$UNTIL")
	if is_off "$s"; then
		note "Claude (lf-claude) hat volles sudo bis $(date -d "@$end" +%H:%M), freigegeben von $(caller_name)"
	else
		note "Claude (lf-claude) hat volles sudo bis $(date -d "@$end" +%H:%M), verlängert an der Konsole von $(caller_name)"
	fi
	;;
aus)
	((EUID == 0)) || { echo "lf-freigabe: nur mit sudo" >&2; exit 2; }
	if in_claude_cgroup; then
		# Aus der cgroup von Claude heraus hielte lf-freigabe sich selbst an. Das Ende läuft dann
		# als eigener Dienst; dieser Aufruf wartet darauf, sofern er nicht selbst beendet wird.
		exec systemd-run --quiet --wait --collect --unit="$UNIT-aus" -p UnsetEnvironment="$ENV_UNSAFE" /usr/local/bin/lf-freigabe aus
	fi
	off
	note "Volles sudo für Claude (lf-claude) beendet"
	;;
ablauf)
	((EUID == 0)) || exit 2
	off
	note "Volles sudo für Claude (lf-claude) abgelaufen"
	;;
status | "")
	status
	;;
zeile)
	# Claude Code gibt der Statuszeile JSON auf der Standardeingabe, es wird nicht gebraucht.
	cat >/dev/null 2>&1 || true
	s=$(status)
	if [[ $s == an* ]]; then
		echo "ACHTUNG: Claude hat volles sudo ($s)"
	elif [[ $s == "aus, "* ]]; then
		echo "Leuchtfeuer: Claude arbeitet mit lf-lesen und lf-aufgabe, ${s#aus, }"
	else
		echo "Leuchtfeuer: Claude arbeitet mit lf-lesen und lf-aufgabe"
	fi
	;;
*)
	echo "Aufruf: lf-freigabe an [MINUTEN] | aus | status" >&2
	exit 2
	;;
esac
