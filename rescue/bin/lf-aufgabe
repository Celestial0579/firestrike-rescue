#!/bin/bash
# Leuchtfeuer: Rettungsaufgaben für Claude (Benutzer lf-claude).
#
# Claude läuft als eigener Benutzer ohne Zugriff auf Blockgeräte. sudo erlaubt ihm nur lf-lesen
# (Diagnose) und dieses Programm (/etc/sudoers.d/lf-claude). Damit erledigt Claude die
# Rettungsaufgaben selbständig, aber nur auf die Art, die auch der Assistent hat:
#   - Eine Quelle wird vor allem anderen schreibgeschützt und nur lesend eingehängt.
#   - Geschrieben wird nur auf das bestätigte Ziel: die Partition, die der Assistent nach der
#     Bestätigung des Technikers unter /mnt/lf-target eingehängt hat. Claude kann dort nichts
#     einhängen und kein anderes Ziel wählen.
#   - Formatieren, Partitionieren und beliebige Befehle als root gibt es hier nicht.
# Jedes Argument wird geprüft, bevor etwas geschieht. Jede Aufgabe steht im Protokoll.
#
#   lf-aufgabe einhaengen GERÄT        Partition nur lesend unter /mnt/lf-image/NAME einhängen
#   lf-aufgabe aushaengen NAME         /mnt/lf-image/NAME aushängen
#   lf-aufgabe image FALL              image.img eines Rettungsfalls nur lesend einbinden
#   lf-aufgabe kopieren PFAD [ORDNER]  aus /mnt/lf-image aufs Ziel nach LF/claude/ORDNER kopieren
#   lf-aufgabe pruefen PFAD [ORDNER]   die Kopie per Prüfsumme gegen PFAD prüfen, Ergebnis aufs Ziel
#   lf-aufgabe timeout GERÄT SEKUNDEN  kurze Timeouts für eine schreibgeschützte Quelle (3 bis 120)
#   lf-aufgabe ablegen FALL DATEI      Textdatei aus dem Home von Claude in den Rettungsfall legen
#   lf-aufgabe retten GERÄT [--domain PARTITION] [--haengt]
#                                       Rettungsfall auf dem Ziel anlegen, ddrescue im Hintergrund.
#                                       Mit --domain zuerst MFT und belegte Cluster dieser NTFS-Partition,
#                                       mit --haengt im Modus hängende Disk (lib/hang.sh)
#   lf-aufgabe domain FALL PARTITION   Domain für einen Fall, der noch nicht über Phase 1 hinaus ist
#   lf-aufgabe fortsetzen FALL GERÄT [--haengt]
#                                       unterbrochene Rettung im Hintergrund fortsetzen
#   lf-aufgabe stand                   laufende Rettungen und letzte Aufgaben
#   lf-aufgabe notiz TEXT              Eintrag ins Protokoll des Assistenten
#
# GERÄT ist /dev/NAME, FALL der Name eines Ordners unter <Ziel>/LF/.
set -u
PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
export LC_ALL=C.UTF-8
umask 022
LF_LIB=/usr/local/lib/lf
for f in common disks safety casefile target recover; do
	# shellcheck disable=SC1090
	. "$LF_LIB/$f.sh"
done

AUFGABEN_LOG=$LF_RUN/claude-aufgaben.log
# Timeout in Sekunden für den Modus hängende Disk (--haengt), wie im Assistenten
HANG_TIMEOUT_DEFAULT=5
LF_LOG=$AUFGABEN_LOG
# Es gibt keine Oberfläche: Was eine Rückfrage bräuchte, geht nur über den Assistenten.
log() { printf '%s %s\n' "$(date '+%F %T')" "$*" >>"$AUFGABEN_LOG"; }
ui_msg() { printf '%s: %b\n' "$1" "$2" >&2; }
ui_info() { :; }
ui_yesno() { return 1; }
ui_input() { return 1; }
ui_menu() { return 1; }

fail() {
	echo "lf-aufgabe: $*" >&2
	log "abgelehnt: $*"
	exit 2
}

# dev GERÄT   wie in lf-lesen: nur /dev/NAME eines Blockgeräts, das der Kernel kennt.
dev() {
	[[ ${1:-} =~ ^/dev/([a-z][a-z0-9]{0,31})$ ]] || fail "kein Gerät: '${1:-}' (erwartet /dev/NAME)"
	[[ -e /sys/class/block/${BASH_REMATCH[1]} && -b $1 && ! -L $1 ]] || fail "kein Blockgerät: $1"
	printf '%s\n' "$1"
}

# disk_of GERÄT   Die Disk, zu der GERÄT gehört (bei einer Disk: sie selbst).
disk_of() {
	local p
	p=$(lsblk -dno PKNAME "$1" 2>/dev/null)
	if [[ -n $p ]]; then echo "/dev/$p"; else echo "$1"; fi
}

# target_disk   Die Disk unter /mnt/lf-target, leer ohne bestätigtes Ziel.
target_disk() {
	local src
	mountpoint -q "$LF_TARGET_MNT" || return 0
	src=$(findmnt -no SOURCE -M "$LF_TARGET_MNT" 2>/dev/null)
	[[ -b $src ]] && disk_of "$src"
}

# target_ok   Es gibt ein bestätigtes Ziel, und es ist mit den Schutzoptionen eingehängt.
target_ok() {
	[[ -n $(target_disk) ]] || fail "Kein Ziel eingehängt. Das Ziel wählt und bestätigt der Techniker im Assistenten."
	target_mount_has_opts || fail "Das Ziel ist nicht mit den Schutzoptionen eingehängt."
}

# disk_written DISK   Hat ein Prozess DISK, eine ihrer Partitionen oder ein Gerät darauf zum
#   Schreiben offen (etwa dd oder partclone eines laufenden Klons)?
disk_written() {
	local -a nodes
	local f n pid fd flags
	mapfile -t nodes < <(lsblk -lnpo NAME "$1" 2>/dev/null)
	((${#nodes[@]})) || return 1
	for f in /proc/[0-9]*/fd/*; do
		for n in "${nodes[@]}"; do
			[[ $f -ef $n ]] || continue
			pid=${f#/proc/}
			pid=${pid%%/*}
			fd=${f##*/}
			flags=$(awk '$1 == "flags:" {print $2}' "/proc/$pid/fdinfo/$fd" 2>/dev/null)
			[[ $flags =~ ^[0-7]+$ ]] && (((8#$flags & 3) != 0)) && return 0
		done
	done
	return 1
}

# disk_mounted_rw DISK   Ist DISK oder eine ihrer Partitionen irgendwo schreibbar eingehängt?
#   Wer über ein Dateisystem schreibt, hat das Gerät selbst nicht offen.
disk_mounted_rw() {
	local -a nodes
	local src opts n
	mapfile -t nodes < <(lsblk -lnpo NAME "$1" 2>/dev/null)
	((${#nodes[@]})) || return 1
	while read -r src opts; do
		for n in "${nodes[@]}"; do
			[[ $src == "$n" && ",$opts," == *,rw,* ]] && return 0
		done
	done < <(findmnt -rn -o SOURCE,OPTIONS 2>/dev/null)
	return 1
}

# source_ok GERÄT   GERÄT darf Quelle sein: nicht der Stick, nicht das Ziel, kein Hilfsgerät
#   (nbd: Overlay eines Klons, zram) und keine Disk, auf die gerade ein Job schreibt. Ein
#   blockdev --setro darauf ließe den Job mitten im Lauf scheitern (GHSA-p86q-3456-f288).
#   Maßgeblich ist die Jobliste des Assistenten (LF_JOBS), denn zwischen zwei Kopierschritten hat
#   kein Prozess die Ziel-Disk offen. Offene Schreibzugriffe und schreibbar eingehängte
#   Dateisysteme fangen ab, was nicht in der Liste steht.
source_ok() {
	local d bd td j
	d=$(disk_of "$1")
	bd=$(boot_disk 2>/dev/null || true)
	td=$(target_disk)
	[[ -n $bd && $d == "$bd" ]] && fail "$1 liegt auf dem Leuchtfeuer-Stick."
	[[ -n $td && $d == "$td" ]] && fail "$1 liegt auf dem Ziel. Das Ziel ist keine Quelle."
	[[ $d =~ ^/dev/(nbd|zram)[0-9]+$ ]] && fail "$1 ist ein Hilfsgerät (nbd, zram), keine Quelle."
	while IFS= read -r j; do
		[[ $(disk_of "$j") == "$d" ]] && fail "$1 ist Ziel eines laufenden Jobs (Klon), keine Quelle."
	done < <(job_disks)
	disk_written "$d" && fail "$1 wird gerade beschrieben (laufender Klon oder anderer Job), keine Quelle."
	disk_mounted_rw "$d" && fail "$1 ist schreibbar eingehängt, keine Quelle."
	return 0
}

# case_dir FALL   Ordner eines Rettungsfalls auf dem Ziel.
case_dir() {
	casefile_dirname_ok "${1:-}" || fail "kein gültiger Fallname: '${1:-}'"
	local c=$LF_TARGET_MNT/LF/$1
	[[ -d $c && ! -L $c && -f $c/case.env && ! -L $c/case.env ]] || fail "Rettungsfall $1 nicht gefunden"
	printf '%s\n' "$c"
}

# image_src PFAD   PFAD liegt auf einer nur lesend eingehängten Quelle unter /mnt/lf-image.
image_src() {
	local src
	src=$(realpath -e -- "$1" 2>/dev/null) || fail "gibt es nicht: $1"
	[[ $src == "$LF_IMAGE_MNT"/?* ]] || fail "Gelesen wird nur aus $LF_IMAGE_MNT (nur lesend eingehängte Quellen)."
	[[ ,$(findmnt -no OPTIONS -T "$src"), == *,ro,* ]] || fail "$src liegt nicht auf einem nur lesend eingehängten Dateisystem."
	printf '%s\n' "$src"
}

# claude_dir NAME   Ordner unter LF/claude auf dem Ziel, NAME ohne Pfad.
claude_dir() {
	[[ $1 =~ ^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$ ]] || fail "kein gültiger Ordnername: '$1'"
	printf '%s\n' "$LF_TARGET_MNT/LF/claude/$1"
}

# make_domain FALLORDNER DISK PARTITION   Domains aus der NTFS-Bitmap (#46): domain-mft.map
#   (die MFT) und domain.map (belegte Cluster), bezogen auf die ganze Disk. Gelesen wird nur von
#   der schreibgeschützten Quelle, mit ddru_ntfsbitmap in einem eigenen Arbeitsordner.
make_domain() {
	local c=$1 disk=$2 part=$3 off work rc
	[[ $(disk_of "$part") == "$disk" && $part != "$disk" ]] || fail "$part ist keine Partition von $disk."
	safety_is_ro "$disk" && safety_is_ro "$part" || fail "$disk ist nicht schreibgeschützt."
	[[ $(blkid -p -o value -s TYPE "$part" 2>/dev/null) == ntfs ]] || fail "$part ist kein NTFS. Domains gibt es nur für NTFS."
	command -v ddru_ntfsbitmap >/dev/null || fail "ddru_ntfsbitmap (ddrutility) ist in diesem Image nicht installiert."
	off=$(($(cat "/sys/class/block/$(basename "$part")/start") * 512))
	work=$(mktemp -d "$LF_RUN/domain.XXXXXX") || fail "Arbeitsordner fehlt."
	log "domain: $part (Offset $off) auf $disk für $c"
	(cd "$work" && ddru_ntfsbitmap -i "$off" -m domain-mft.map "$disk" domain.map) >>"$AUFGABEN_LOG" 2>&1
	rc=$?
	if ((rc != 0)) || ! casefile_domain_ok "$work/domain.map" || ! casefile_domain_ok "$work/domain-mft.map"; then
		rm -rf "${work:?}"
		fail "ddru_ntfsbitmap hat keine gültige Domain erzeugt (rc=$rc). Protokoll: $AUFGABEN_LOG"
	fi
	install -m 0644 "$work/domain-mft.map" "$c/domain-mft.map" && install -m 0644 "$work/domain.map" "$c/domain.map" ||
		{ rm -rf "${work:?}"; fail "Die Domain ließ sich nicht im Fall ablegen."; }
	rm -rf "${work:?}"
	echo "Domain angelegt: zuerst die MFT, dann die belegten Cluster von $part."
}

# start_rescue FALLORDNER QUELLE   lf-rescue-run im Hintergrund, als eigene systemd-Einheit.
start_rescue() {
	local unit
	unit="lf-claude-rettung-$(printf '%s' "$1" | sha256sum | cut -c1-12)"
	systemctl is-active -q "$unit" && fail "Für diesen Fall läuft schon eine Rettung ($unit)."
	systemd-run --quiet --collect --unit="$unit" --description="Leuchtfeuer: Rettung $(basename "$1")" \
		/usr/local/bin/lf-rescue-run "$1" "$2" --no-pause ${LF_TECHNIKER:+"--techniker=$LF_TECHNIKER"} ||
		fail "Die Rettung ließ sich nicht starten."
	log "Rettung gestartet: $1 von $2 ($unit)"
	echo "Rettung läuft im Hintergrund ($unit). Stand: sudo lf-aufgabe stand"
}

[[ $# -ge 1 ]] || fail "Aktion fehlt (einhaengen, aushaengen, image, kopieren, pruefen, retten, domain, fortsetzen, timeout, ablegen, stand, notiz)"
action=$1
shift
log "Claude: $action $(printf '%q ' "$@")"
case $action in
einhaengen)
	(($# == 1)) || fail "einhaengen erwartet ein Gerät"
	part=$(dev "$1") || exit 2
	source_ok "$part"
	disk=$(disk_of "$part")
	# Erst der Schreibschutz, dann das Einhängen. Ein nur lesend eingebundenes Image ist es schon.
	safety_is_ro "$disk" || safety_set_ro "$disk"
	safety_is_ro "$part" || fail "$part ließ sich nicht schreibschützen."
	[[ $(sudo blkid -o value -s TYPE "$part") == BitLocker ]] && fail "BitLocker braucht den Wiederherstellungsschlüssel. Das macht der Techniker im Assistenten."
	mp="$LF_IMAGE_MNT/$(basename "$part")"
	part_mount_ro "$part" "$mp" || fail "$part ließ sich nicht nur lesend einhängen. Protokoll: $AUFGABEN_LOG"
	echo "$part ist nur lesend unter $mp eingehängt."
	;;
aushaengen)
	(($# == 1)) || fail "aushaengen erwartet einen Namen"
	[[ $1 =~ ^[a-z][a-z0-9]{0,31}$ ]] || fail "kein gültiger Name: '$1'"
	mp=$LF_IMAGE_MNT/$1
	mountpoint -q "$mp" || fail "$mp ist nicht eingehängt"
	umount "$mp" || fail "$mp ist noch in Benutzung"
	echo "$mp ausgehängt."
	;;
image)
	(($# == 1)) || fail "image erwartet einen Fallnamen"
	target_ok
	c=$(case_dir "$1") || exit 2
	[[ -f $c/image.img && ! -L $c/image.img ]] || fail "Im Fall $1 gibt es kein image.img"
	loop=$(image_attach "$c/image.img" ro)
	[[ $(blockdev --getro "$loop") == 1 ]] || fail "Das Image ist nicht nur lesend eingebunden."
	echo "$c/image.img ist nur lesend als $loop eingebunden. Partitionen: sudo lf-lesen disks"
	;;
kopieren)
	(($# == 1 || $# == 2)) || fail "kopieren erwartet PFAD [ORDNER]"
	target_ok
	src=$(image_src "$1") || exit 2
	dst=$(claude_dir "${2:-$(basename "$src")}") || exit 2
	install -d "$LF_TARGET_MNT/LF" "$LF_TARGET_MNT/LF/claude" "$dst" || fail "Kann $dst nicht anlegen."
	ropts=(-aHAX --no-devices --no-specials)
	case $(target_fs) in exfat | ntfs* | fuseblk) ropts=(-rt --modify-window=2) ;; esac
	log "kopieren: $src -> $dst"
	rsync "${ropts[@]}" --info=stats1 --ignore-errors -- "$src" "$dst/" 2>&1 | tee -a "$AUFGABEN_LOG"
	rc=${PIPESTATUS[0]}
	log "kopieren beendet: rc=$rc"
	echo "Ziel: $dst (rsync rc=$rc)"
	exit "$rc"
	;;
pruefen)
	(($# == 1 || $# == 2)) || fail "pruefen erwartet PFAD [ORDNER]"
	target_ok
	src=$(image_src "$1") || exit 2
	dst=$(claude_dir "${2:-$(basename "$src")}") || exit 2
	[[ -d $dst && ! -L $dst ]] || fail "Es gibt keine Kopie unter $dst. Erst kopieren."
	out="$dst.pruefung.txt"
	# Dieselbe Auswahl wie beim Kopieren, nur als Trockenlauf mit Prüfsummen: Jede Datei, deren
	# Inhalt abweicht oder fehlt, steht in der Ausgabe.
	{
		echo "Prüfung $(date '+%F %T'): $src gegen $dst"
		echo "Dateien in der Quelle: $(find "$src" -type f | wc -l), in der Kopie: $(find "$dst/$(basename "$src")" -type f 2>/dev/null | wc -l)"
		rsync -rcn --out-format='ABWEICHUNG: %n' -- "$src" "$dst/" 2>&1
		echo "rsync rc=$?"
	} >"$out"
	n=$(grep -c '^ABWEICHUNG: ' "$out")
	log "pruefen: $src gegen $dst, $n Abweichungen"
	cat "$out"
	((n == 0)) || exit 1
	;;
timeout)
	(($# == 2)) || fail "timeout erwartet GERÄT SEKUNDEN"
	d=$(dev "$1") || exit 2
	[[ $(lsblk -dno TYPE "$d") == disk ]] || fail "$d ist keine ganze Disk."
	[[ $2 =~ ^[0-9]{1,3}$ ]] && ((10#$2 >= 3 && 10#$2 <= 120)) || fail "SEKUNDEN 3 bis 120"
	# Nur für Quellen: Sie sind schon schreibgeschützt. Ziel und Stick bleiben, wie sie sind.
	source_ok "$d"
	safety_is_ro "$d" || fail "$d ist nicht als Quelle schreibgeschützt. Erst einhaengen oder retten."
	n=$(basename "$d")
	[[ -w /sys/block/$n/device/timeout ]] || fail "$d hat keinen einstellbaren Timeout (kein SCSI/SATA/USB-Gerät)."
	echo "$((10#$2))" >"/sys/block/$n/device/timeout" || fail "Timeout ließ sich nicht setzen."
	[[ -w /sys/block/$n/device/eh_timeout ]] && echo "$((10#$2))" >"/sys/block/$n/device/eh_timeout"
	log "timeout: $d auf $((10#$2)) s"
	echo "$d: Timeout $((10#$2)) s (gilt bis zum Abziehen)."
	;;
ablegen)
	(($# == 2)) || fail "ablegen erwartet FALL DATEI"
	target_ok
	c=$(case_dir "$1") || exit 2
	home=$(getent passwd lf-claude | cut -d: -f6)
	[[ -n $home ]] || fail "Benutzer lf-claude fehlt."
	f=$(realpath -e -- "$2" 2>/dev/null) || fail "gibt es nicht: $2"
	[[ $f == "$home"/?* && -f $f ]] || fail "Abgelegt werden nur Dateien aus $home."
	name=$(basename "$f")
	[[ $name =~ ^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$ ]] || fail "kein gültiger Dateiname: '$name'"
	# Gelesen wird mit den Rechten von lf-claude, nie als root: Eine Verknüpfung, die nach der
	# Prüfung an die Stelle der Datei tritt, kann so nur auf etwas zeigen, das Claude ohnehin lesen darf.
	tmp=$(mktemp "$c/.claude-ablage.XXXXXX") || fail "Ablegen fehlgeschlagen."
	runuser -u lf-claude -- head -c $((10 * 1024 * 1024 + 1)) -- "$f" >"$tmp" 2>/dev/null
	if (($(stat -c %s "$tmp") > 10 * 1024 * 1024)) || ! grep -qI . "$tmp"; then
		rm -f "$tmp"
		fail "nur Textdateien bis 10 MB"
	fi
	chmod 0644 "$tmp" && mv -f "$tmp" "$c/claude-$name" || { rm -f "$tmp"; fail "Ablegen fehlgeschlagen."; }
	log "ablegen: $f -> $c/claude-$name"
	echo "Abgelegt: $c/claude-$name"
	;;
retten)
	(($# >= 1)) || fail "retten erwartet GERÄT [--domain PARTITION] [--haengt]"
	sarg=$1
	shift
	parg="" hang=()
	while (($#)); do
		case $1 in
		--domain)
			[[ $# -ge 2 && -z $parg ]] || fail "retten erwartet GERÄT [--domain PARTITION] [--haengt]"
			parg=$2
			shift 2
			;;
		--haengt)
			hang=("HANG_TIMEOUT=$HANG_TIMEOUT_DEFAULT")
			shift
			;;
		*) fail "retten erwartet GERÄT [--domain PARTITION] [--haengt]" ;;
		esac
	done
	target_ok
	sdev=$(dev "$sarg") || exit 2
	dpart=""
	if [[ -n $parg ]]; then
		dpart=$(dev "$parg") || exit 2
		[[ $(disk_of "$dpart") == "$sdev" && $dpart != "$sdev" ]] || fail "$dpart ist keine Partition von $sdev."
	fi
	[[ $(lsblk -dno TYPE "$sdev") == disk || $sdev == /dev/loop* ]] || fail "$sdev ist keine ganze Disk."
	source_ok "$sdev"
	sj=$(lsblk -J -b -d -o PATH,SIZE,MODEL,SERIAL,WWN "$sdev" 2>/dev/null |
		jq -c '.blockdevices[0] // empty | .serial = ((.serial // "") | gsub("^\\s+|\\s+$"; ""))')
	[[ -n $sj ]] || fail "$sdev meldet keine Angaben."
	size=$(jq -r .size <<<"$sj")
	safety_set_ro "$sdev"
	free=$(target_free)
	if ((free < size)); then
		case $(target_fs) in
		ext4 | xfs | btrfs) echo "Hinweis: Auf dem Ziel sind nur $(human "$free") frei, die Quelle hat $(human "$size"). Das Image wird sparse geschrieben." ;;
		*) fail "Auf dem Ziel sind nur $(human "$free") frei, benötigt werden $(human "$size")." ;;
		esac
	fi
	sid=$(jq -r 'if (.serial // "") != "" then .serial elif (.wwn // "") != "" then .wwn else .path end' <<<"$sj")
	model=$(jq -r '.model // "Disk"' <<<"$sj" | tr -c 'A-Za-z0-9._-' '_' | sed 's/_*$//')
	name="$(date +%Y%m%d-%H%M)_${model}_${sid//[^A-Za-z0-9]/_}"
	name=${name:0:200}
	casefile_dirname_ok "$name" || name="$(date +%Y%m%d-%H%M)_Disk"
	c="$LF_TARGET_MNT/LF/$name"
	[[ -e $c ]] && fail "Den Fall $name gibt es schon."
	install -d "$LF_TARGET_MNT/LF" "$c" || fail "Kann $c nicht anlegen."
	casefile_value_ok SRC_ID "$sid" || sid=$sdev
	tid=$(target_disk)
	casefile_create "$c/case.env" "SRC_ID=$sid" "SRC_SIZE=$size" \
		"SRC_LABEL=$(casefile_clean_text "$(disk_label "$sj")")" "TARGET_ID=$tid" "STATE=new" "${hang[@]}" ||
		fail "Der Rettungsfall konnte nicht angelegt werden: $CASEFILE_ERROR"
	echo "Neuer Rettungsfall: $name"
	((${#hang[@]})) && echo "Modus hängende Disk: Timeout $HANG_TIMEOUT_DEFAULT s, nach einem Hänger weiter hinter der Hängerstelle."
	[[ -n $dpart ]] && make_domain "$c" "$sdev" "$dpart"
	start_rescue "$c" "$sdev"
	;;
domain)
	(($# == 2)) || fail "domain erwartet FALL PARTITION"
	target_ok
	c=$(case_dir "$1") || exit 2
	part=$(dev "$2") || exit 2
	disk=$(disk_of "$part")
	source_ok "$disk"
	casefile_load "$c/case.env" || fail "Die Falldatei ist ungültig."
	[[ $(casefile_get PHASE_DONE 0) == 0 ]] || fail "Der Fall ist schon über Phase 1 hinaus. Eine Domain spart dann nichts mehr."
	# Die Disk muss die Quelle dieses Falls sein, geprüft wie in lf-rescue-run.
	info=$(lsblk -J -b -d -o SERIAL,WWN,SIZE "$disk" 2>/dev/null | jq -c '.blockdevices[0] // empty')
	casefile_source_check "$(jq -r '(.serial // "") | gsub("^\\s+|\\s+$"; "")' <<<"$info")" "$(jq -r '.wwn // ""' <<<"$info")" "$(jq -r '.size // ""' <<<"$info")" ||
		[[ $? == 3 ]] || fail "$disk ist nicht die Quelle dieses Falls: $CASEFILE_ERROR"
	safety_is_ro "$disk" || safety_set_ro "$disk"
	make_domain "$c" "$disk" "$part"
	echo "Weiter mit: sudo lf-aufgabe fortsetzen $1 $disk"
	;;
fortsetzen)
	(($# == 2)) || [[ $# == 3 && $3 == --haengt ]] || fail "fortsetzen erwartet FALL GERÄT [--haengt]"
	target_ok
	c=$(case_dir "$1") || exit 2
	sdev=$(dev "$2") || exit 2
	source_ok "$sdev"
	safety_set_ro "$sdev"
	if (($# == 3)); then
		casefile_load "$c/case.env" || fail "Die Falldatei ist ungültig: $CASEFILE_ERROR"
		if [[ -z $(casefile_get HANG_TIMEOUT) ]]; then
			casefile_set "$c/case.env" HANG_TIMEOUT "$HANG_TIMEOUT_DEFAULT" || fail "Die Falldatei lässt sich nicht fortschreiben: $CASEFILE_ERROR"
		fi
		echo "Modus hängende Disk ist für diesen Fall an."
	fi
	# Ob die Disk zum Fall gehört, prüft lf-rescue-run selbst gegen die Falldatei.
	start_rescue "$c" "$sdev"
	;;
stand)
	(($# == 0)) || fail "stand erwartet keine Argumente"
	echo "## Rettungen im Hintergrund"
	systemctl list-units --all --plain --no-legend 'lf-claude-rettung-*' 2>/dev/null || true
	if [[ -n $(target_disk) ]]; then
		for m in "$LF_TARGET_MNT"/LF/*/image.map; do
			[[ -f $m && ! -L $m ]] || continue
			echo
			echo "## $(basename "$(dirname "$m")")"
			ddrescuelog -t "$m" 2>/dev/null | tail -n 12
		done
	fi
	echo
	echo "## Letzte Aufgaben"
	tail -n 20 "$AUFGABEN_LOG"
	;;
notiz)
	(($# == 1)) || fail "notiz erwartet einen Text (in Anführungszeichen)"
	text=$(printf '%s' "$1" | jq -Rr --arg re "$TEXT_UNSAFE_RE" '.[0:300] | gsub($re; "?")')
	main_log=$(ls -t "$LF_PERSIST"/logs/lf-*.log "$LF_RUN"/logs/lf-*.log 2>/dev/null | head -n 1)
	[[ -n $main_log && ! -L $main_log ]] && printf '%s [Claude] %s\n' "$(date '+%F %T')" "$text" >>"$main_log"
	echo "Notiert."
	;;
*)
	fail "unbekannte Aktion: $action"
	;;
esac
