#!/bin/bash
# Leuchtfeuer: claude startet nur mit den Einstellungen des Rettungssystems und des Benutzers.
#
# Claude Code liest sonst auch die Projekt-Einstellungen des Ordners, in dem es startet
# (.claude/settings.json, .claude/settings.local.json, CLAUDE.md). Liegt der Ordner auf einem
# fremden Datenträger, könnte er nach der Vertrauensabfrage Umgebungsvariablen setzen
# (etwa ANTHROPIC_BASE_URL) oder ein Hilfsprogramm starten lassen (apiKeyHelper). Mit
# --setting-sources user lädt Claude Code keine Projekt-Einstellungen. Die verwalteten
# Einstellungen (/etc/claude-code) gelten weiter, das prüft der Selbsttest der ISO.
#
# Die CLI selbst liegt in /usr/local/lib/lf/claude-cli (aus der ISO) oder, aktualisiert, in
# ~/.local/bin/claude auf dem persistenten Speicher. Beide stehen nicht vor diesem Skript im PATH.
# Die aktualisierte startet nur, wenn sie die Prüfung der Sperre bestanden hat (lf-claude-check,
# einmal je Version). Sonst startet die CLI der ISO, die der Selbsttest der ISO geprüft hat.
set -u
for a in "$@"; do
	[[ $a == --setting-sources* ]] || continue
	echo "claude: --setting-sources ist im Rettungssystem fest auf \"user\" gesetzt." >&2
	exit 2
done
cli=/usr/local/lib/lf/claude-cli
if [[ -x ${HOME:-}/.local/bin/claude ]]; then
	if "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/lf-claude-check" "$HOME/.local/bin/claude"; then
		cli=$HOME/.local/bin/claude
	else
		echo "Gestartet wird die geprüfte Claude-Code-CLI aus der ISO." >&2
	fi
fi
exec "$cli" --setting-sources user "$@"
