#!/usr/bin/env bash
# Führt die ddrescue-Phasen für einen Rettungsfall aus. Läuft als root, meist in tmux.
# Wird ein Lauf unterbrochen, setzt ein erneuter Aufruf anhand von image.map fort.
#
#   lf-rescue-run CASE_DIR QUELLE [--no-pause] [--techniker=NAME]
#
# CASE_DIR enthält case.env mit SRC_ID (Seriennummer/WWN/Pfad) und SRC_SIZE.
# QUELLE ist der Gerätepfad der Disk, die der Techniker als Quelle gewählt hat.
# NAME steht im Bericht. Der Assistent übergibt LF_TECHNIKER aus der lf.conf.
#
# Der Fallordner liegt auf der Ziel-Disk, also auf einem Datenträger, den jemand angeschlossen
# hat. case.env wird deshalb als Daten gelesen und geprüft, nie als Shell-Code (lib/casefile.sh).
# Aus demselben Grund bestimmt die Falldatei nie, von welcher Disk gelesen wird: Die Quelle
# kommt als Argument vom Aufrufer. Die Falldatei kann dieser Wahl nur widersprechen.

set -uo pipefail

PAUSE=1
TECH=""
ARGS=()
for a in "$@"; do
	case $a in
	--no-pause) PAUSE=0 ;;
	--techniker=*) TECH=${a#--techniker=} ;;
	*) ARGS+=("$a") ;;
	esac
done
if ((${#ARGS[@]} != 2)); then
	echo "Aufruf: lf-rescue-run CASE_DIR QUELLE [--no-pause] [--techniker=NAME]" >&2
	echo "QUELLE ist der Gerätepfad der Quell-Disk, zum Beispiel /dev/sdb. Ohne sie wird nichts gelesen." >&2
	exit 2
fi
CASE=${ARGS[0]%/}
SRC=${ARGS[1]}

# Je Fall läuft höchstens eine Rettung: Der Assistent und Claude (lf-aufgabe) können beide eine
# starten. Zwei ddrescue auf derselben Mapfile würden sie zerstören.
lock_dir=/run/lf
[[ -d $lock_dir && -w $lock_dir ]] || lock_dir=${TMPDIR:-/tmp}
exec 8>"$lock_dir/rettung-$(realpath -m -- "$CASE" | sha256sum | cut -c1-16).lock"
if ! flock -n 8; then
	echo "Für diesen Rettungsfall läuft schon eine Rettung. Es wurde nichts gestartet." >&2
	exit 1
fi

ENV="$CASE/case.env"
IMG="$CASE/image.img"
MAP="$CASE/image.map"
LOG="$CASE/rescue.log"

# Die Bibliothek liegt neben diesem Skript: installiert unter /usr/local/lib/lf, im Repository
# unter rescue/lib. Bewusst ohne Umweg über die Umgebung, das Skript läuft als root.
HERE=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
LIB=$HERE/../lib/lf
[[ -r $LIB/casefile.sh ]] || LIB=$HERE/../lib
[[ -r $LIB/casefile.sh ]] || { echo "lf-rescue-run: $LIB/casefile.sh fehlt." >&2; exit 2; }
# shellcheck disable=SC1090
. "$LIB/casefile.sh"
# shellcheck disable=SC1090
. "$LIB/hang.sh"

# Der Name steht nur im Bericht, als Text: höchstens 100 Zeichen, Steuerzeichen und die Zeichen
# " $ ` \ werden zu "_". Dieselben Grenzen gelten für LF_TECHNIKER in der lf.conf.
[[ -n $TECH ]] && TECH=$(casefile_clean_text "${TECH:0:100}")

say() { printf '\n\033[1;33m%s\033[0m\n' "$*" | tee -a "$LOG"; }
finish() {
	if ((PAUSE)); then
		echo
		read -r -p "Enter drücken, um zum Assistenten zurückzukehren … " _
	fi
	exit "${1:-0}"
}
# Schlüssel in der Falldatei setzen. Der Wert wird geprüft, die Datei neu geschrieben.
setv() {
	casefile_set "$ENV" "$1" "$2" && return 0
	say "Die Falldatei lässt sich nicht fortschreiben: $CASEFILE_ERROR"
	finish 2
}

# Dieses Skript schreibt als root in den Fallordner. Läge dort statt einer Datei eine
# Verknüpfung oder ein Gerät, schriebe es durch sie hindurch an eine ganz andere Stelle,
# zum Beispiel mit ddrescue auf eine interne Disk. Deshalb vor dem ersten Schreiben prüfen.
if [[ -L $CASE || ! -d $CASE ]]; then
	echo "Dieser Rettungsfall wird nicht verwendet: $CASE ist kein gewöhnlicher Ordner." >&2
	finish 2
fi
for f in "$ENV" "$IMG" "$MAP" "$LOG" "$CASE/smart-before.txt" "$CASE/smart-after.txt" "$CASE/report.txt"; do
	if [[ -L $f || (-e $f && ! -f $f) ]]; then
		echo "Dieser Rettungsfall wird nicht verwendet: $f ist keine gewöhnliche Datei." >&2
		echo "Im Fallordner liegen nur gewöhnliche Dateien. Es wurde nichts geschrieben." >&2
		finish 2
	fi
done

if ! casefile_load "$ENV"; then
	echo "Dieser Rettungsfall wird nicht verwendet. Seine Falldatei ist ungültig:" >&2
	echo "  $CASEFILE_ERROR" >&2
	echo "Die Datei wurde nur gelesen, nichts daraus wurde ausgeführt." >&2
	finish 2
fi
SRC_ID=$(casefile_get SRC_ID)
SRC_SIZE=$(casefile_get SRC_SIZE)
SRC_LABEL=$(casefile_get SRC_LABEL "$SRC_ID")

# Gelesen wird von der Disk, die der Techniker gewählt hat (QUELLE), nie von einer, die die
# Falldatei nennt. Eine präparierte Falldatei könnte sonst eine interne Disk als Quelle angeben,
# deren Abbild dann auf der fremden Ziel-Disk landet. Die Angaben der Falldatei dienen nur der
# Gegenprobe: Passen Kennung oder Größe nicht zur gewählten Disk, wird nichts gelesen.
if ! casefile_value_ok SRC_PATH "$SRC"; then
	echo "Die Rettung wird nicht gestartet: $SRC ist kein Gerätepfad unter /dev." >&2
	finish 2
fi
# lsblk sagt, ob das Gerät da ist, und liefert, was es über sich selbst meldet.
INFO=$(lsblk -J -b -d -o PATH,SERIAL,WWN,SIZE "$SRC" 2>/dev/null | jq -c '.blockdevices[0] // empty' 2>/dev/null)
if [[ -z $INFO ]]; then
	say "Quell-Disk $SRC ist nicht (mehr) angeschlossen. Der Stand ist gespeichert; nach dem Anschließen 'Unterbrochene Rettung fortsetzen' wählen."
	setv STATE interrupted
	finish 1
fi
NOTE=""
# Was die gewählte Disk über sich meldet. Nach einem Hänger (lib/hang.sh) wird nur eine Disk
# angenommen, die genau dasselbe meldet.
SRC_SERIAL=$(jq -r '(.serial // "") | gsub("^\\s+|\\s+$"; "")' <<<"$INFO")
SRC_WWN=$(jq -r '.wwn // ""' <<<"$INFO")
ID_STRICT=1
casefile_source_check "$SRC_SERIAL" "$SRC_WWN" "$(jq -r '.size // ""' <<<"$INFO")"
case $? in
0) ;;
3)
	NOTE="Die Falldatei nennt für die Quelle nur einen Gerätepfad, keine Seriennummer und keinen WWN. Geprüft ist deshalb allein die Größe."
	ID_STRICT=0
	;;
*)
	echo "Die Rettung wird nicht gestartet: $SRC ist nicht die Quelle dieses Rettungsfalls." >&2
	echo "  $CASEFILE_ERROR" >&2
	echo "Es wurde nichts gelesen und nichts geschrieben." >&2
	finish 2
	;;
esac
# set_ro GERÄT   Schreibschutz für die Disk und ihre Partitionen, vermerkt wie im Assistenten.
set_ro() {
	local p
	blockdev --setro "$1" 2>/dev/null || true
	for p in $(lsblk -nr -o PATH "$1" 2>/dev/null | tail -n +2); do
		blockdev --setro "$p" 2>/dev/null || true
	done
	[[ -d /run/lf && ! -L /run/lf/readonly ]] && echo "$1" >>/run/lf/readonly
}
set_ro "$SRC"

# Modus "hängende Disk" (#54), eingeschaltet über HANG_TIMEOUT in der Falldatei
HANG_T=$(casefile_get HANG_TIMEOUT)
HANG=0
[[ -n $HANG_T ]] && HANG=1
SKIP=$(($(casefile_get HANG_SKIP 64) * 1024 * 1024))
HANG_MAX=100
HANG_WAIT=1800
# Die Disk, auf der der Fall liegt. Sie wird nie als wiedergekehrte Quelle angenommen.
TARGET_DISK=$(findmnt -no SOURCE -T "$CASE" 2>/dev/null)
if [[ -n $TARGET_DISK ]]; then
	pk=$(lsblk -dno PKNAME "$TARGET_DISK" 2>/dev/null)
	[[ -n $pk ]] && TARGET_DISK=/dev/$pk
fi

# Sparse schreiben, wo das Ziel-Dateisystem es kann
SPARSE=()
case $(findmnt -no FSTYPE -T "$CASE") in
ext4 | ext3 | xfs | btrfs) SPARSE=(-S) ;;
esac

setv STATE running
setv SRC_PATH "$SRC"
[[ -z $(casefile_get STARTED) ]] && setv STARTED "$(date -Is)"
[[ -f $CASE/smart-before.txt ]] || smartctl -x "$SRC" >"$CASE/smart-before.txt" 2>&1

say "Leuchtfeuer · Datenrettung von $SRC ($SRC_ID) nach $IMG"
[[ -n $NOTE ]] && say "Hinweis: $NOTE"
if ((HANG)); then
	say "Modus hängende Disk: Timeout $HANG_T s, bei einem Hänger Abbruch statt Warten, danach weiter $((SKIP / 1024 / 1024)) MiB hinter der Hängerstelle. Die Lücke wird später nachgeholt."
	hang_set_timeout "$SRC" "$HANG_T" || say "Hinweis: $SRC hat keinen einstellbaren Timeout (etwa NVMe). ddrescue gibt trotzdem nach kurzer Zeit ohne Erfolg auf."
	((ID_STRICT)) || say "Hinweis: Ohne Seriennummer und WWN wartet der Lauf nach einem Hänger nicht auf die Disk. Fortsetzen geht dann von Hand."
fi
echo "Mit Strg+B, D verlässt du die Ansicht; die Rettung läuft weiter." | tee -a "$LOG"

PHASES=(
	"1|vor|Schneller Durchlauf: gut lesbare Bereiche zuerst, schwache überspringen|-n"
	"2|rueck|Rückwärts-Durchlauf über die übersprungenen Bereiche|-n -R"
	"3|vor|Fehlerbereiche einzeln mit Direktzugriff und 3 Wiederholungen|-d -r3"
)
DONE=$(casefile_get PHASE_DONE 0)

# hang_wait   Wartet nach einem Hänger auf genau die Quell-Disk. Ist sie wieder da, gilt sie
# als Quelle (SRC), schreibgeschützt und mit kurzen Timeouts. Rückgabe 1 nach HANG_WAIT Sekunden.
hang_wait() {
	local i dev gone=0
	for ((i = 0; i < HANG_WAIT; i++)); do
		sleep 1
		hang_present "$SRC" || gone=1
		dev=$(hang_find "$SRC_SERIAL" "$SRC_WWN" "$SRC_SIZE") || continue
		# Dieselbe Gerätedatei zählt erst, wenn die Disk zwischendurch weg war: Eine Disk, die
		# noch hängt, wäre sonst sofort wieder die Quelle.
		[[ $dev != "$SRC" ]] || ((gone)) || continue
		casefile_value_ok SRC_PATH "$dev" || continue
		[[ -n $TARGET_DISK && $dev == "$TARGET_DISK" ]] && continue
		SRC=$dev
		set_ro "$SRC"
		hang_set_timeout "$SRC" "$HANG_T" || true
		setv SRC_PATH "$SRC"
		say "Die Disk ist wieder da: $SRC. Seriennummer/WWN und Größe stimmen, sie ist schreibgeschützt."
		return 0
	done
	say "Die Disk ist in $((HANG_WAIT / 60)) Minuten nicht wieder erschienen. Stand gespeichert, später fortsetzen."
	return 1
}

# hang_handle SCHRITT GERETTET_VORHER   Nach einem Abbruch im Modus hängende Disk: Hängerstelle
# merken, dann weiter oder auf die Disk warten. Rückgabe 1: Der Lauf endet, Stand gespeichert.
hang_handle() {
	local id=$1 before=$2 pos n dev
	pos=$(hang_map_pos "$MAP") || pos=0
	n=$(($(casefile_get HANGS 0) + 1))
	setv HANG_STEP "$id"
	setv HANG_POS "$pos"
	setv HANGS "$n"
	say "Hänger Nr. $n bei $((pos / 1024 / 1024)) MiB (Schritt $id). Der Stand ist gespeichert."
	if ((n >= HANG_MAX)); then
		say "Die Disk ist $n-mal hängen geblieben. Der Lauf endet hier. Ob es weitergeht, entscheidet der Techniker."
		return 1
	fi
	if ((!ID_STRICT)); then
		say "Nach dem Neustart der Disk 'Unterbrochene Rettung fortsetzen' wählen. Gelesen wird dann hinter der Hängerstelle weiter."
		return 1
	fi
	dev=$(hang_find "$SRC_SERIAL" "$SRC_WWN" "$SRC_SIZE")
	if [[ $dev == "$SRC" ]] && (($(hang_map_rescued "$MAP") > before)); then
		say "Die Disk antwortet noch. Es geht gleich hinter der Hängerstelle weiter."
		return 0
	fi
	say "Die Disk antwortet nicht mehr. Bitte neu starten: Strom trennen (Kabel oder Adapter abziehen), etwa 10 Sekunden warten, wieder anschließen. Gewartet wird bis zu $((HANG_WAIT / 60)) Minuten auf genau diese Disk."
	hang_wait
}

# step SCHRITT RICHTUNG ddrescue-Optionen …   Ein ddrescue-Durchlauf. RICHTUNG ist vor oder rueck.
# Im Modus hängende Disk beginnt der Durchlauf nach einem Hänger in diesem Schritt hinter der
# Hängerstelle (vor: ab Position + SKIP, rueck: bis Position − SKIP). Was davor liegt, holen
# die späteren Phasen nach, für Phase 3 ein weiterer Durchlauf ohne Versatz.
# Rückgabe 0, wenn der Schritt fertig ist. Sonst endet das Skript mit gespeichertem Stand.
step() {
	local id=$1 dir=$2 rc pos before skipped empty
	local -a off topt
	shift 2
	while :; do
		off=() topt=() skipped=0 empty=0
		if ((HANG)); then
			topt=(-T "$(hang_ddrescue_timeout "$id" "$HANG_T")")
			if [[ $(casefile_get HANG_STEP) == "$id" ]]; then
				skipped=1
				pos=$(casefile_get HANG_POS 0)
				if [[ $dir == vor ]]; then
					if ((pos + SKIP < SRC_SIZE)); then off=(-i "$((pos + SKIP))"); else empty=1; fi
				else
					if ((pos > SKIP)); then off=(-s "$((pos - SKIP))"); else empty=1; fi
				fi
				say "Weiter hinter der Hängerstelle bei $((pos / 1024 / 1024)) MiB."
			fi
		fi
		before=$(hang_map_rescued "$MAP")
		rc=0
		if ((!empty)); then
			ddrescue "${SPARSE[@]}" "${topt[@]}" "$@" "${off[@]}" "$SRC" "$IMG" "$MAP" 2>&1 | tee -a "$LOG"
			rc=${PIPESTATUS[0]}
		fi
		if ((rc == 0)); then
			((skipped)) || return 0
			casefile_unset "$ENV" HANG_STEP && casefile_unset "$ENV" HANG_POS ||
				{ say "Die Falldatei lässt sich nicht fortschreiben: $CASEFILE_ERROR"; finish 2; }
			[[ $id == 3 ]] || return 0
			say "Phase 3: die Lücke hinter der Hängerstelle nachholen"
			continue
		fi
		if ((!HANG)); then
			if [[ ! -b $SRC ]]; then
				say "Die Quell-Disk ist verschwunden (USB-Reset oder Ausfall). Stand gespeichert, später fortsetzen."
			else
				say "ddrescue meldet Fehler (rc=$rc). Stand gespeichert, Fortsetzen ist möglich."
			fi
			setv STATE interrupted
			finish "$rc"
		fi
		if ! hang_handle "$id" "$before"; then
			setv STATE interrupted
			finish 1
		fi
	done
}

# Phase 0 (#46): Liegen im Fall Domains (lf-aufgabe domain, aus der NTFS-Bitmap der Quelle),
# liest ddrescue zuerst nur sie: die MFT, dann die belegten Cluster. Danach holen die Phasen
# 1 bis 3 den Rest in derselben Mapfile, ohne Gelesenes erneut zu lesen. Nach Phase 1 lohnt
# eine Domain nicht mehr.
if ((DONE == 0)); then
	for d in domain-mft.map domain.map; do
		f=$CASE/$d
		[[ -e $f || -L $f ]] || continue
		if ! casefile_domain_ok "$f"; then
			say "$d ist keine gültige Domain-Mapfile und wird nicht verwendet."
			continue
		fi
		case $d in
		domain-mft.map) title="nur die MFT (Verwaltung des Dateisystems)" id=0m ;;
		*) title="nur die belegten Cluster" id=0d ;;
		esac
		say "Phase 0: $title"
		step "$id" vor -n -m "$f"
	done
fi

for ph in "${PHASES[@]}"; do
	IFS='|' read -r n dir title opts <<<"$ph"
	((n <= DONE)) && continue
	say "Phase $n/3: $title"
	setv PHASE "$n"
	# shellcheck disable=SC2086
	step "$n" "$dir" $opts
	setv PHASE_DONE "$n"
	DONE=$n
done

say "Abschluss"
smartctl -x "$SRC" >"$CASE/smart-after.txt" 2>&1
setv FINISHED "$(date -Is)"
setv STATE "done"
{
	echo "Leuchtfeuer · Rettungsbericht"
	echo "==================================="
	echo
	echo "Quelle:      $SRC_LABEL"
	echo "Kennung:     $SRC_ID"
	echo "Größe:       $SRC_SIZE Bytes"
	echo "Image:       $IMG"
	echo "Begonnen:    $(casefile_get STARTED)"
	echo "Beendet:     $(date -Is)"
	echo "System:      Leuchtfeuer $(. /etc/lf-release 2>/dev/null; echo "${LF_VERSION:-dev}")"
	[[ -n $TECH ]] && echo "Techniker:   $TECH"
	[[ -n $(casefile_get HANGS) ]] && echo "Hänger:      $(casefile_get HANGS) (Modus hängende Disk)"
	echo
	echo "Ergebnis (ddrescuelog -t):"
	ddrescuelog -t "$MAP"
	echo
	echo "Fehlende Bereiche (Position, Größe in Bytes):"
	ddrescuelog -l- -b1 "$MAP" 2>/dev/null | head -n 50 || true
	echo
	echo "SMART vorher/nachher: smart-before.txt, smart-after.txt"
} >"$CASE/report.txt" 2>&1
cat "$CASE/report.txt"
say "Fertig. Bericht: $CASE/report.txt"
finish 0
