#!/usr/bin/env bash
# Führt die ddrescue-Phasen für einen Rettungsfall aus. Läuft als root, meist in tmux.
# Wird ein Lauf unterbrochen, setzt ein erneuter Aufruf anhand von image.map fort.
#
#   frs-rescue-run CASE_DIR [--no-pause]
#
# CASE_DIR enthält case.env mit SRC_ID (Seriennummer/WWN/Pfad) und SRC_SIZE.
#
# Der Fallordner liegt auf der Ziel-Disk, also auf einem Datenträger, den jemand angeschlossen
# hat. case.env wird deshalb als Daten gelesen und geprüft, nie als Shell-Code (lib/casefile.sh).

set -uo pipefail

CASE=${1:?Aufruf: frs-rescue-run CASE_DIR}
CASE=${CASE%/}
PAUSE=1
[[ ${2:-} == --no-pause ]] && PAUSE=0

ENV="$CASE/case.env"
IMG="$CASE/image.img"
MAP="$CASE/image.map"
LOG="$CASE/rescue.log"

# Die Bibliothek liegt neben diesem Skript: installiert unter /usr/local/lib/frs, im Repository
# unter rescue/lib. Bewusst ohne Umweg über die Umgebung, das Skript läuft als root.
HERE=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
LIB=$HERE/../lib/frs
[[ -r $LIB/casefile.sh ]] || LIB=$HERE/../lib
[[ -r $LIB/casefile.sh ]] || { echo "frs-rescue-run: $LIB/casefile.sh fehlt." >&2; exit 2; }
# shellcheck disable=SC1090
. "$LIB/casefile.sh"

say() { printf '\n\033[1;33m%s\033[0m\n' "$*" | tee -a "$LOG"; }
finish() {
	if ((PAUSE)); then
		echo
		read -r -p "Enter drücken, um zum Assistenten zurückzukehren … " _
	fi
	exit "${1:-0}"
}
# Schlüssel in der Falldatei setzen. Der Wert wird geprüft, die Datei neu geschrieben.
setv() {
	casefile_set "$ENV" "$1" "$2" && return 0
	say "Die Falldatei lässt sich nicht fortschreiben: $CASEFILE_ERROR"
	finish 2
}

# Dieses Skript schreibt als root in den Fallordner. Läge dort statt einer Datei eine
# Verknüpfung oder ein Gerät, schriebe es durch sie hindurch an eine ganz andere Stelle,
# zum Beispiel mit ddrescue auf eine interne Disk. Deshalb vor dem ersten Schreiben prüfen.
if [[ -L $CASE || ! -d $CASE ]]; then
	echo "Dieser Rettungsfall wird nicht verwendet: $CASE ist kein gewöhnlicher Ordner." >&2
	finish 2
fi
for f in "$ENV" "$IMG" "$MAP" "$LOG" "$CASE/smart-before.txt" "$CASE/smart-after.txt" "$CASE/report.txt"; do
	if [[ -L $f || (-e $f && ! -f $f) ]]; then
		echo "Dieser Rettungsfall wird nicht verwendet: $f ist keine gewöhnliche Datei." >&2
		echo "Im Fallordner liegen nur gewöhnliche Dateien. Es wurde nichts geschrieben." >&2
		finish 2
	fi
done

if ! casefile_load "$ENV"; then
	echo "Dieser Rettungsfall wird nicht verwendet. Seine Falldatei ist ungültig:" >&2
	echo "  $CASEFILE_ERROR" >&2
	echo "Die Datei wurde nur gelesen, nichts daraus wurde ausgeführt." >&2
	finish 2
fi
SRC_ID=$(casefile_get SRC_ID)
SRC_SIZE=$(casefile_get SRC_SIZE)
SRC_LABEL=$(casefile_get SRC_LABEL "$SRC_ID")

# Quelle über die Kennung auflösen; der Gerätepfad kann sich nach USB-Resets ändern.
SRC=$(lsblk -J -b -d -o PATH,SERIAL,WWN | jq -r --arg id "$SRC_ID" \
	'.blockdevices[] | select(((.serial // "") | gsub("^\\s+|\\s+$"; "")) == $id or .wwn == $id or .path == $id) | .path' | head -n1)
# Ohne Seriennummer und WWN ist die Kennung der Gerätepfad selbst. Die Prüfung der Falldatei
# lässt als Pfad nur /dev/… ohne ".." zu.
[[ -z $SRC && $SRC_ID == /dev/* && -b $SRC_ID ]] && SRC=$SRC_ID
if [[ -z $SRC ]]; then
	say "Quell-Disk $SRC_ID ist nicht (mehr) angeschlossen. Der Stand ist gespeichert; nach dem Anschließen 'Unterbrochene Rettung fortsetzen' wählen."
	setv STATE interrupted
	finish 1
fi
blockdev --setro "$SRC" 2>/dev/null || true

# Sparse schreiben, wo das Ziel-Dateisystem es kann
SPARSE=()
case $(findmnt -no FSTYPE -T "$CASE") in
ext4 | ext3 | xfs | btrfs) SPARSE=(-S) ;;
esac

setv STATE running
setv SRC_PATH "$SRC"
[[ -z $(casefile_get STARTED) ]] && setv STARTED "$(date -Is)"
[[ -f $CASE/smart-before.txt ]] || smartctl -x "$SRC" >"$CASE/smart-before.txt" 2>&1

say "Firestrike Rescue · Datenrettung von $SRC ($SRC_ID) nach $IMG"
echo "Mit Strg+B, D verlässt du die Ansicht; die Rettung läuft weiter." | tee -a "$LOG"

PHASES=(
	"1|Schneller Durchlauf: gut lesbare Bereiche zuerst, schwache überspringen|-n"
	"2|Rückwärts-Durchlauf über die übersprungenen Bereiche|-n -R"
	"3|Fehlerbereiche einzeln mit Direktzugriff und 3 Wiederholungen|-d -r3"
)
DONE=$(casefile_get PHASE_DONE 0)
for ph in "${PHASES[@]}"; do
	IFS='|' read -r n title opts <<<"$ph"
	((n <= DONE)) && continue
	say "Phase $n/3: $title"
	setv PHASE "$n"
	# shellcheck disable=SC2086
	ddrescue "${SPARSE[@]}" $opts "$SRC" "$IMG" "$MAP" 2>&1 | tee -a "$LOG"
	rc=${PIPESTATUS[0]}
	if ((rc != 0)); then
		if [[ ! -b $SRC ]]; then
			say "Die Quell-Disk ist verschwunden (USB-Reset oder Ausfall). Stand gespeichert, später fortsetzen."
		else
			say "ddrescue meldet Fehler (rc=$rc). Stand gespeichert, Fortsetzen ist möglich."
		fi
		setv STATE interrupted
		finish "$rc"
	fi
	setv PHASE_DONE "$n"
	DONE=$n
done

say "Abschluss"
smartctl -x "$SRC" >"$CASE/smart-after.txt" 2>&1
setv FINISHED "$(date -Is)"
setv STATE "done"
{
	echo "Firestrike Rescue · Rettungsbericht"
	echo "==================================="
	echo
	echo "Quelle:      $SRC_LABEL"
	echo "Kennung:     $SRC_ID"
	echo "Größe:       $SRC_SIZE Bytes"
	echo "Image:       $IMG"
	echo "Begonnen:    $(casefile_get STARTED)"
	echo "Beendet:     $(date -Is)"
	echo "System:      Firestrike Rescue $(. /etc/frs-release 2>/dev/null; echo "${FRS_VERSION:-dev}")"
	echo
	echo "Ergebnis (ddrescuelog -t):"
	ddrescuelog -t "$MAP"
	echo
	echo "Fehlende Bereiche (Position, Größe in Bytes):"
	ddrescuelog -l- -b1 "$MAP" 2>/dev/null | head -n 50 || true
	echo
	echo "SMART vorher/nachher: smart-before.txt, smart-after.txt"
} >"$CASE/report.txt" 2>&1
cat "$CASE/report.txt"
say "Fertig. Bericht: $CASE/report.txt"
finish 0
