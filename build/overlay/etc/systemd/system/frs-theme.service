[Unit]
Description=Firestrike-Farbpalette für die Konsole
# Nach Ubuntus setvtrgb.service, das sonst die Standardpalette zurücksetzt
After=systemd-vconsole-setup.service setvtrgb.service
Before=getty@tty1.service

[Service]
Type=oneshot
ExecStart=setvtrgb /usr/local/share/frs/theme/vtrgb
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
